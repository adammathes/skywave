            body: Body(
                window: ByUse(
                    residential: Window(w_share: 0, w: (1.3, 1.3), head: 1.35, h_max: 1.3),
                    office: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
                    other: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
