    signs: SignRules(
        // Striped, solid, a flat canopy, none: equally often.
        awnings: [(Striped, 1), (Solid, 1), (Canopy, 1), (None, 1)],
        lit_box_256: 70,
        shop_lit_256: 115,
    ),

    lots: LotRules(
        front_min_yard: 9.5,
        stall_w: 2.8,
        front_fill: (0.25, 0.75),
        aisle_fill: 0.4,
