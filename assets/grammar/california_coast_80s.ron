    signs: SignRules(
        // Over a run of storefronts: canvas sheds (striped, solid) most, then vinyl
        // bullnoses, aluminum sheds, flat stucco canopies, shingled mansards (80s remodels).
        awnings: [
            (Striped, 3),
            (Solid, 3),
            (Bullnose, 2),
            (Aluminum, 2),
            (Canopy, 2),
            (Mansard, 1),
            (None, 2),
        ],
        // Along a strip mall: the shingled mansard on posts, else a flat stucco canopy.
        mall_canopies: [(Mansard, 3), (Canopy, 2)],
        lit_box_256: 70,
        shop_lit_256: 115,

        // Shop signs (the blade signs on storefronts): a pictogram and a wordmark from the
        // lexicon. `descriptors_out` skips a descriptor whose pair with the trade would name
        // a well-known business. Starting values for a 1985 beach strip, not yet fitted (B3): food,
        // drink, the motel and the surf trade lead.
        lexicon: "us_roadside",
        trades: [
            TradeRule(trade: "DONUTS", weight: 3, pictograms: [(Donut, 3), (CoffeeCup, 1)], lines: [(Word("OPEN"), 2), (Since, 1)], descriptors_out: ["ROYAL"]),
            TradeRule(trade: "CAFE", weight: 2, pictograms: [(CoffeeCup, 3), (Sun, 1)], lines: [(Word("OPEN"), 1)]),
            TradeRule(trade: "DINER", weight: 2, pictograms: [(CoffeeCup, 2), (Burger, 1), (Star, 1)], lines: [(Word("OPEN"), 2), (Since, 1)]),
            TradeRule(trade: "BURGERS", weight: 3, pictograms: [(Burger, 1)], lines: [(Word("OPEN"), 1)]),
            TradeRule(trade: "TACOS", weight: 3, pictograms: [(Taco, 1)], lines: [(Word("OPEN"), 1)]),
            TradeRule(trade: "PIZZA", weight: 2, pictograms: [(PizzaSlice, 1)], lines: [(Since, 1)]),
            TradeRule(trade: "ICE CREAM", weight: 2, pictograms: [(IceCreamCone, 1)], lines: []),
            TradeRule(trade: "HOT DOGS", weight: 1, pictograms: [(HotDog, 1)], lines: []),
            TradeRule(trade: "SEAFOOD", weight: 1, pictograms: [(Fish, 2), (Wave, 1)], lines: [(Since, 1)]),
            TradeRule(trade: "COCKTAILS", weight: 2, pictograms: [(MartiniGlass, 2), (Star, 1)], lines: [(Word("OPEN"), 1)]),
            TradeRule(trade: "LOUNGE", weight: 2, pictograms: [(MartiniGlass, 2), (Star, 1)], lines: [(Word("COCKTAILS"), 1)]),
            TradeRule(trade: "TAVERN", weight: 1, pictograms: [(BeerMug, 1)], lines: [(Word("COCKTAILS"), 1)]),
            TradeRule(trade: "LIQUOR", weight: 3, pictograms: [(BeerMug, 1), (MartiniGlass, 1)], lines: [(Word("OPEN"), 1)]),
            TradeRule(trade: "SURFBOARDS", weight: 2, pictograms: [(Surfboard, 3), (Wave, 2), (Palm, 1)], lines: []),
            TradeRule(trade: "MOTEL", weight: 3, pictograms: [(Arrow, 3), (Palm, 1), (Star, 1), (Sun, 1), (Wave, 1)], lines: [(Word("VACANCY"), 1)]),
            TradeRule(trade: "RECORDS", weight: 2, pictograms: [(Record, 1)], lines: [], descriptors_out: ["LAKESHORE"]),
            TradeRule(trade: "TV REPAIR", weight: 1, pictograms: [(TvSet, 1)], lines: [(Since, 1)]),
            TradeRule(trade: "PHOTO", weight: 1, pictograms: [(Camera, 1)], lines: []),
            TradeRule(trade: "VIDEO", weight: 2, pictograms: [(FilmReel, 2), (TvSet, 1), (Star, 1)], lines: []),
            TradeRule(trade: "BARBER", weight: 1, pictograms: [(ScissorsComb, 1)], lines: [(Since, 1)]),
            TradeRule(trade: "SHOES", weight: 1, pictograms: [(Shoe, 1)], lines: [(Since, 1)]),
