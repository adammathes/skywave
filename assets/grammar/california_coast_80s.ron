                bay_w: ByUse(residential: 3.6, office: 2.8, other: 3),
                door: ByUse(residential: (1, 2.2), office: (2, 2.6), other: (2, 2.6)),
                ground: ByUse(
                    residential: GroundBays(storefront: 0, lobby: 0, garage: 0, wall: 0, door: 0),
                    office: GroundBays(storefront: 2, lobby: 2, garage: 0, wall: 1, door: 0),
                    other: GroundBays(storefront: 6, lobby: 0, garage: 0, wall: 1, door: 1),
                ),
                front_bay_w: (5.5, 8),
                pier_w: (0.35, 0.5),
                storefront: Storefront(
                    bulkhead_h: (0.4, 0.6),
                    glass_top: (2.6, 3),
                    transom_h: (0.5, 0.9),
                    transom_glass_256: 64,
                    entry: (1.1, 2.25),
                    recessed_256: 64,
