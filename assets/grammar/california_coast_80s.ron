// The 1980s Southern California beach town (`california_coast`, Eighties): the numbers and
// weights the building planner reads. Format: crates/world/src/grammar.rs and
// docs/WORLD_GENERATION.md ("Facade grammars"). Lengths are meters; `ByUse` splits a value
// by what the building is used for (residential, office, anything else); a `_256` share
// is out of 256; count ranges are inclusive and `(0, 0)` draws nothing.
//
// Styles may have several entries: a building takes the first entry, in file order, of its
// style whose `zones` hold its zone (`All`, or `Only([...])`), so zone-specific entries
// come before the `All` one.
//
// Provenance: every value below is a starting value, not yet fitted (ADR 0005, "Fit"; B3
// fits them). Most are the planner's former code constants. The three-band facade's
// (B4: `ground`, `front_bay_w`, `pier_w`, `storefront`, body `kinds`, top `kinds` and
// `cornice_d`, the 4–5 m ground floor) are starting values from docs/backlog/BUILDINGS.md
// ("The grammar", the 1980s SoCal table): bulkhead 0.4–0.6 m, display glass to 2.6–3.0 m,
// transom 0.5–0.9 m, recessed entries 1.0–1.8 m in pre-war fronts and flush in remodeled
// ones. A fitted number replaces one of these with a comment naming its source and item
// (see CREDITS.md).
Grammar(
    era: Eighties,
    template: "california_coast",

    styles: [
        // Stucco sheds and workshops in industrial zones: loading doors, no shops.
        StyleRules(
            style: StuccoBox,
            zones: Only([Industrial]),
            massing: Massing(
                even_floors: ByUse(residential: true, office: false, other: false),
                floor_h: 3.3,
                ground_floor_h: (4, 5),
                ground_share_max: 0.6,
            ),
            base: Base(
                plinth_h: ByUse(residential: 0.12, office: 0.45, other: 0.45),
                bay_w: ByUse(residential: 3.6, office: 2.8, other: 3),
                door: ByUse(residential: (1, 2.2), office: (2, 2.6), other: (2, 2.6)),
                ground: ByUse(
                    residential: GroundBays(storefront: 0, lobby: 0, garage: 0, wall: 0, door: 0),
                    office: GroundBays(storefront: 2, lobby: 2, garage: 0, wall: 1, door: 0),
                    other: GroundBays(storefront: 0, lobby: 0, garage: 3, wall: 2, door: 1),
                ),
                front_bay_w: (5.5, 8),
                pier_w: (0.35, 0.5),
                storefront: Storefront(
                    bulkhead_h: (0.4, 0.6),
                    glass_top: (2.6, 3),
                    transom_h: (0.5, 0.9),
                    transom_glass_256: 64,
                    entry: (1.1, 2.25),
                    recessed_256: 64,
                    recess: (1, 1.8),
                    side_entry_256: 128,
                ),
            ),
            body: Body(
                window: ByUse(
                    residential: Window(w_share: 0, w: (1.3, 1.3), head: 1.35, h_max: 1.3),
                    office: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
                    other: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
                ),
                kinds: ByUse(
                    residential: WindowKinds(punched: 3, paired: 1, ribbon: 0, bay: 0, picture: 1),
                    office: WindowKinds(punched: 2, paired: 1, ribbon: 2, bay: 0, picture: 0),
                    other: WindowKinds(punched: 3, paired: 2, ribbon: 0, bay: 0, picture: 1),
                ),
                window_h_min: 0.6,
                sill_ground: 0.65,
                sill_upper: 0.9,
            ),
            top: Top(
                parapet_h: ByUse(residential: 0.5, office: 0.8, other: 0.8),
                kinds: TopKinds(parapet: 3, cornice: 1, stepped: 1),
                cornice_d: 0.3,
            ),
            addenda: Addenda(
                roof_vents: ByUse(residential: (1, 2), office: (2, 4), other: (2, 4)),
                roof_units: ByUse(residential: (0, 0), office: (1, 2), other: (1, 2)),
                bulkhead_floors: 4,
                water_tank_1_in: 2,
            ),
        ),
        // Shops and flats in smooth stucco; the lower parapet on flats.
        StyleRules(
            style: StuccoBox,
            zones: All,
            massing: Massing(
                even_floors: ByUse(residential: true, office: false, other: false),
                floor_h: 3.3,
