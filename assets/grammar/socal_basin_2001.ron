// The 2001 Southern California basin (`socal_basin`, Aughts): Mirage Valley's buildings,
// the numbers and weights the building planner reads (docs/backlog/MIRAGE2001.md item 3).
// Format: crates/world/src/grammar.rs and docs/WORLD_GENERATION.md ("Facade grammars"), as
// for the coast's (`california_coast_80s.ron`, which this started from).
//
// What changes from the 1980s coast: stucco boxes with plain parapets (fewer cornices, no
// false fronts); auto shops in the industrial stucco (roll-up bays and a shop front);
// mini-malls under a flat canopy; awnings vinyl and aluminum, not canvas; lots busy into the
// night; bus stops along the arterials; billboards mostly blank (no lettered ads). The
// filler keeps quiet so the landmarks stand out: the buildings' sign bands carry no names,
// only bare stucco, a plain fascia or a wall in one strong color; the words of the turn of
// the century (`lexicon_2001.ron`: taco stands, auto shops, pagers and phones) are on the
// blade neon and the landmarks. Tilt-up warehouses, dingbats and the tract houses' tile
// roofs come from their styles' rules as on the coast; the downtown towers from the
// template's downtown massing. Every value is a starting value, not yet fitted (ADR 0005).
Grammar(
    era: Aughts,
    template: "socal_basin",

    styles: [
        // Stucco sheds and workshops in industrial zones: loading doors, no shops.
        StyleRules(
            style: StuccoBox,
            zones: Only([Industrial]),
            massing: Massing(
                even_floors: ByUse(residential: true, office: false, other: false),
                floor_h: 3.3,
                ground_floor_h: (4, 5),
                ground_share_max: 0.6,
            ),
            base: Base(
                plinth_h: ByUse(residential: 0.12, office: 0.45, other: 0.45),
                bay_w: ByUse(residential: 3.6, office: 2.8, other: 3),
                door: ByUse(residential: (1, 2.2), office: (2, 2.6), other: (2, 2.6)),
                ground: ByUse(
                    residential: GroundBays(storefront: 0, lobby: 0, garage: 0, wall: 0, door: 0),
                    office: GroundBays(storefront: 2, lobby: 2, garage: 0, wall: 1, door: 0),
                    other: GroundBays(storefront: 1, lobby: 0, garage: 4, wall: 1, door: 1),
                ),
                front_bay_w: (5.5, 8),
                pier_w: (0.35, 0.5),
                storefront: Storefront(
                    bulkhead_h: (0.4, 0.6),
                    glass_top: (2.6, 3),
                    transom_h: (0.5, 0.9),
                    transom_glass_256: 64,
                    entry: (1.1, 2.25),
                    recessed_256: 64,
                    recess: (1, 1.8),
                    side_entry_256: 128,
                ),
            ),
            body: Body(
                window: ByUse(
                    residential: Window(w_share: 0, w: (1.3, 1.3), head: 1.35, h_max: 1.3),
                    office: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
                    other: Window(w_share: 0.5, w: (0.9, 1.6), head: 1.3, h_max: 1.7),
                ),
                kinds: ByUse(
                    residential: WindowKinds(punched: 3, paired: 1, ribbon: 0, bay: 0, picture: 1),
                    office: WindowKinds(punched: 2, paired: 1, ribbon: 2, bay: 0, picture: 0),
                    other: WindowKinds(punched: 3, paired: 2, ribbon: 0, bay: 0, picture: 1),
                ),
                window_h_min: 0.6,
                sill_ground: 0.65,
                sill_upper: 0.9,
            ),
            top: Top(
                parapet_h: ByUse(residential: 0.5, office: 0.8, other: 0.8),
                kinds: TopKinds(
                    parapet: 6, cornice: 0, stepped: 1, shaped: 0,
                    false_front: 0, bracketed: 0, mansard: 0,
                ),
                cornice_d: 0.3,
            ),
            addenda: Addenda(
                roof_vents: ByUse(residential: (1, 2), office: (2, 4), other: (2, 4)),
                roof_units: ByUse(residential: (0, 0), office: (2, 4), other: (2, 4)),
                exhaust_fans: ByUse(residential: (0, 0), office: (0.5, 1), other: (1, 2)),
                skylights: ByUse(residential: (0, 0), office: (0, 0), other: (0, 0)),
                bulkhead_floors: 4,
                water_tank_1_in: 2,
            ),
        ),
        // Shops and flats in smooth stucco; the lower parapet on flats. Shops told apart by
        // their tops (stepped and shaped parapets) and a roll-up bay or a blank wall, not
