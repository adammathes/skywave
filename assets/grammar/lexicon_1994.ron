// The words Lake City's shop signs may carry (`great_lakes_90s.ron`): a closed list,
// reviewed by a person, never extended by code, beside the coast's (`lexicon.ron`, which
// stays as it is so the coast's signs never change). Format and rules for reviewers as
// there: no real brand, chain, station or street name; no real person's name; no real
// neighborhood; nothing that reads as placeholder text. The names are the coast's invented
// ones; the descriptors, trades and lines are a 1994 North Side's: hot dog and beef
// stands, corner taverns, video stores, pagers and car phones, no surf shops.
Lexicon(
    id: "us_lake",

    syllables: Syllables(
        onsets: ["B", "BR", "C", "D", "DR", "F", "G", "H", "J", "K", "L", "M", "N", "P",
                 "PR", "QU", "R", "S", "SK", "ST", "T", "TR", "V", "W"],
        nuclei: ["A", "E", "I", "O", "U", "Y", "EY", "IE", "OW"],
        codas: ["CK", "D", "K", "L", "LL", "N", "NT", "R", "RD", "RS", "S", "SH", "T", "TT",
                "V"],
    ),

    given: [
        "VORNIE", "DELVA", "RENNA", "KESTA", "LORNIE", "BRELLA", "SOVIE", "DORVAN", "GILVA",
        "HOLVIS", "IVELLA", "JORVEN", "KALDER", "LISSET", "DRELVA", "NELVA", "OTTAL",
