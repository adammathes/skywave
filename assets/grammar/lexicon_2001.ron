// The words the 2001 basin's shop signs may carry (`socal_basin_2001.ron`): a closed list,
// reviewed by a person, never extended by code, beside the coast's (`lexicon.ron`, which
// stays as it is so the coast's signs never change). Format and rules for reviewers as
// there: no real brand, chain, station or street name; no real person's name; nothing
// that reads as placeholder text. The names are the coast's invented ones; the
// descriptors, trades and lines are the turn of the century's: mini-mall tenants, auto
// shops, taco stands, pagers and phones.
Lexicon(
    id: "us_basin",

    syllables: Syllables(
        onsets: ["B", "BR", "C", "D", "DR", "F", "G", "H", "J", "K", "L", "M", "N", "P",
                 "PR", "QU", "R", "S", "SK", "ST", "T", "TR", "V", "W"],
        nuclei: ["A", "E", "I", "O", "U", "Y", "EY", "IE", "OW"],
        codas: ["CK", "D", "K", "L", "LL", "N", "NT", "R", "RD", "RS", "S", "SH", "T", "TT",
                "V"],
    ),

