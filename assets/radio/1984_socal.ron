// Radio preset: 1984 SoCal. Real stations whose stream URLs the broadcasters publish for
// listening in other players (Radio Paradise's stream links for
// WiFi radios and other players, WFMU's playlists, the college stations' own listen links);
// names are the stations' own. Nothing is rehosted. tools/check-streams.mjs played 5 s of
// audio from every URL, as the published page asks for it, on the date in `terms_checked`;
// `verified` turns true after the owner's first listen. Format: crates/audio/src/station.rs,
// docs/AUDIO_RADIO.md.
RadioPreset(
    id: "1984_socal",
    title: "1984 SoCal",
    scenario: "socal_beach_1984",
    stations: [
        Station(
            id: "radioparadise_mellow",
            name: "Radio Paradise Mellow Mix",
            era: "mixed",
            format: "mellow rock and soft pop",
            source: Stream(
                urls: ["https://stream.radioparadise.com/mellow-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "radioparadise_main",
            name: "Radio Paradise Main Mix",
            era: "mixed",
            format: "eclectic album rock",
            source: Stream(
                urls: ["https://stream.radioparadise.com/mp3-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "radioparadise_global",
            name: "Radio Paradise Global Mix",
            era: "mixed",
            format: "world music and eclectic grooves",
            source: Stream(
                urls: ["https://stream.radioparadise.com/global-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
    ],
)
