// Radio preset: 1986 North Shore. Ad-free stations only (docs/AUDIO_RADIO.md, "the ad-free rule"):
// listener-supported, public and college broadcasters that publish their stream URLs for
// listening in other players, each checked for pre-roll and mid-roll ads as its
// `ad-free:` note says. Names are the stations' own. Nothing is rehosted.
// tools/check-streams.mjs plays every URL as the published page asks for it (its Referer
// and Origin) and warns about a station without an `ad-free:` note; `verified` turns true
// after the owner's first listen. Format: crates/audio/src/station.rs.
RadioPreset(
    id: "1986_north_shore",
    title: "1986 North Shore",
    scenario: "north_shore_suburb_1986",
    stations: [
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // non-commercial college station (Northwestern); music both times, no
        // spots and no ad marks on its stream host's redirect. Terms: wnur.org's own player
        // plays this URL; nothing forbids other players.
        Station(
            id: "wnur",
            name: "WNUR 89.3 FM",
            era: "mixed",
            format: "Evanston student freeform, jazz and rock",
            source: Stream(
                urls: ["https://stream.rcs.revma.com/w4pmmfkdx4zuv"],
                homepage: "https://wnur.org/",
                codec: Mp3,
                bitrate_kbps: 192,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // "a free-form non-commercial station", volunteer-run (Lake Forest
        // College); music both times, no spots. Terms: the home page's Listen Live links
        // this stream (http there; the same host serves it over https).
        Station(
            id: "wmxm",
            name: "WMXM 88.9 FM",
            era: "mixed",
            format: "Lake Forest college radio: indie and freeform",
            source: Stream(
                urls: ["https://wmxm.streamguys1.com/live"],
                homepage: "https://wmxm.org/",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // volunteer-run and donation-supported (no ads on the site or the stream);
        // music from the first second both times, ICY titles are track credits. Terms: the
        // channel page publishes this URL and lists outside player apps; no terms forbid it.
        Station(
            id: "intergalactic_cbs",
            name: "Intergalactic FM CBS",
            era: "1980s",
            format: "italo, new wave and electro",
            source: Stream(
                urls: ["https://radio.intergalactic.fm/1A"],
                homepage: "https://www.intergalactic.fm/channels/cybernetic-broadcasting-system",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // listener-supported, "Always 100% commercial-free" (its icy-description); music
        // from the first second both times. Terms: URLs published for other players.
        Station(
            id: "radioparadise_main",
            name: "Radio Paradise Main Mix",
            era: "mixed",
            format: "eclectic album rock",
            source: Stream(
                urls: ["https://stream.radioparadise.com/mp3-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // listener-supported, commercial-free; music from the first second both times.
        // Terms: URLs published for WiFi radios and other players.
        Station(
            id: "radioparadise_rock",
            name: "Radio Paradise Rock Mix",
            era: "mixed",
            format: "classic and album rock",
            source: Stream(
                urls: [
                    "https://stream.radioparadise.com/rock-128",
                    // The same channel in MP3, for players without AAC (native).
                    "https://stream.radioparadise.com/rock-192",
                ],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        // ad-free: 2026-10-27, two 60 s cold starts: no pre-roll, no break, no ad mark;
        // listener-supported, no commercials; music both times. Terms: wfmu.org
        // publishes wfmu.pls for any player (http there; the same host serves it over
        // https).
        Station(
            id: "wfmu",
            name: "WFMU 91.1 FM",
            era: "mixed",
            format: "freeform: rock, soul, oddities",
            source: Stream(
                urls: ["https://stream0.wfmu.org/freeform-128k"],
                homepage: "https://wfmu.org/",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
    ],
)
