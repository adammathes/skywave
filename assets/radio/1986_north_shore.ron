// Radio preset: 1986 North Shore. Real stations whose stream URLs the broadcasters publish for
// listening in other players (Radio Paradise's stream links for
// WiFi radios and other players, WFMU's playlists, the college stations' own listen links);
// names are the stations' own. Nothing is rehosted. tools/check-streams.mjs played 5 s of
// audio from every URL, as the published page asks for it, on the date in `terms_checked`;
// `verified` turns true after the owner's first listen. Format: crates/audio/src/station.rs,
// docs/AUDIO_RADIO.md.
RadioPreset(
    id: "1986_north_shore",
    title: "1986 North Shore",
    scenario: "north_shore_suburb_1986",
    stations: [
        Station(
            id: "wnur",
            name: "WNUR 89.3 FM",
            era: "mixed",
            format: "Evanston student freeform, jazz and rock",
            source: Stream(
                urls: ["https://stream.rcs.revma.com/w4pmmfkdx4zuv"],
                homepage: "https://wnur.org/",
                codec: Mp3,
                bitrate_kbps: 192,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "radioparadise_rock",
            name: "Radio Paradise Rock Mix",
            era: "mixed",
            format: "classic and album rock",
            source: Stream(
                urls: ["https://stream.radioparadise.com/rock-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "radioparadise_main",
            name: "Radio Paradise Main Mix",
            era: "mixed",
            format: "eclectic album rock",
            source: Stream(
                urls: ["https://stream.radioparadise.com/mp3-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
    ],
)
