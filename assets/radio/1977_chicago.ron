// Radio preset: 1977 Chicago. Real stations whose stream URLs the broadcasters publish for
// listening in other players (Radio Paradise's stream links for
// WiFi radios and other players, WFMU's playlists, the college stations' own listen links);
// names are the stations' own. Nothing is rehosted. tools/check-streams.mjs played 5 s of
// audio from every URL, as the published page asks for it, on the date in `terms_checked`;
// `verified` turns true after the owner's first listen. Format: crates/audio/src/station.rs,
// docs/AUDIO_RADIO.md.
RadioPreset(
    id: "1977_chicago",
    title: "1977 Chicago",
    scenario: "chicago_1977",
    stations: [
        Station(
            id: "wdcb",
            name: "WDCB 90.9 FM",
            era: "mixed",
            format: "Chicago jazz and blues",
            source: Stream(
                urls: ["https://wdcb-ice.streamguys1.com/wdcb128"],
                homepage: "https://www.cod.edu/wdcb/streaming-support",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "whpk",
            name: "WHPK 88.5 FM",
            era: "mixed",
            format: "Hyde Park college radio: jazz, blues, soul, rock",
            source: Stream(
                urls: ["https://whpk-stream.uchicago.edu/stream"],
                homepage: "https://whpk.org/",
                codec: Mp3,
                bitrate_kbps: 256,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "wfmu_rocknsoul",
            name: "WFMU Rock'n'Soul Radio",
            era: "1960s",
            format: "soul, R&B and rock 'n' roll 45s",
            source: Stream(
                urls: [
                    "https://stream2.wfmu.org/rocknsoul",
                    "https://stream0.wfmu.org/rocknsoul",
                ],
                homepage: "https://wfmu.org/listen.shtml",
                codec: Mp3,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
        Station(
            id: "radioparadise_rock",
            name: "Radio Paradise Rock Mix",
            era: "mixed",
            format: "classic and album rock",
            source: Stream(
                urls: ["https://stream.radioparadise.com/rock-128"],
                homepage: "https://radioparadise.com/listen/stream-links",
                codec: Aac,
                bitrate_kbps: 128,
                terms_checked: "2026-10-27",
                verified: false,
            ),
        ),
    ],
)
