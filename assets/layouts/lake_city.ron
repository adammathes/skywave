// Lake City (docs/SCENARIOS.md, docs/LAYOUTS.md): a flat grid city of the 1980s on a great lake,
// built to work and warm inside. Its bones are a real great-lakes city's north and west sides,
// squeezed to a mile per 200 m: a section-line grid of arterials a mile apart, the old
// diagonal trails cutting across it to the north-west, a river that comes in from the lake
// beside downtown and forks at once (one branch south, one north-west, splitting again with a
// straight channel north), a shore drive through a lakefront park that narrows going north,
// an expressway out of downtown north-west beside the oldest trail, and the inner suburbs
// past the north limits. Bungalows west, three-flats and storefronts in the middle, towers by
// the river mouth, the drive-in on the plank road near the north-west corner. No circles, no
// loops: every road ends on another road.
//
// Meters, x east, z south, (0, 0) the north-west corner; 16 x 16 chunks, 2048 m square.
Layout(
    id: "lake_city",
    size_chunks: (16, 16),
    ground_m: 180,
    water_level_m: 176,
    edges: Edges(north: Forest, east: Lake, south: RailYards, west: Forest),

    ridges: [],
    peaks: [],

    water: [
        // The lake: its shore runs west going north, so the park and the drive narrow there.
        Water(kind: Lake, depth_m: 4.2, polygon: [(1520, 0), (2048, 0), (2048, 2048), (1986, 2048), (1986, 1836), (1936, 1636), (1886, 1436), (1761, 1236), (1711, 1036), (1686, 836), (1636, 636), (1561, 236), (1524, 36)]),
    ],

    // Three-flats on a grid unless a district says otherwise.
    default_zone: Residential,
    districts: [
        // The inner suburbs past the north limits and the line road: houses under big trees.
        District(name: "north suburbs", zone: Suburb, polygon: [(0, 0), (1050, 0), (1050, 236), (0, 236)]),
        // The bungalow belt: the whole west side, a storey and a half of brick, every lot alike.
        District(name: "bungalow belt", zone: Suburb, polygon: [(0, 236), (836, 236), (836, 2048), (0, 2048)]),
        // Woods along the north-west branch of the river.
        District(name: "river woods", zone: Park, polygon: [(540, 0), (650, 0), (800, 240), (690, 262)]),
        // Industry along both branches near downtown: rail spurs, tanneries, warehouses.
        District(name: "river yards", zone: Industrial, polygon: [(1740, 1740), (1560, 1420), (1420, 1200), (1240, 1000), (1180, 1060), (1350, 1280), (1480, 1460), (1660, 1790), (1690, 2048), (1790, 2048)]),
        // Storefronts with flats above along the old trails and the cross-town street.
        District(name: "plank road stores", zone: Commercial, polygon: [(1362, 1406), (662, 806), (610, 866), (1310, 1466)]),
        District(name: "north diagonal stores", zone: Commercial, polygon: [(1472, 1018), (1072, 218), (1000, 254), (1400, 1054)]),
        District(name: "crosstown stores", zone: Commercial, polygon: [(36, 806), (1640, 806), (1640, 866), (36, 866)]),
        // The plank road's run near the north-west corner: the drive-in, the car wash, the
        // muffler shop.
        District(name: "drive-in stretch", zone: Strip, polygon: [(546, 599), (296, 199), (176, 273), (426, 673)]),
        // Parks: the lakefront the length of the city, widest in the middle, and two big
        // neighborhood parks.
        District(name: "lakefront", zone: Park, polygon: [(1480, 0), (1520, 0), (1524, 36), (1561, 236), (1636, 636), (1686, 836), (1711, 1036), (1761, 1236), (1886, 1436), (1936, 1636), (1986, 1836), (1986, 2048), (1951, 2048), (1951, 1836), (1901, 1636), (1851, 1436), (1726, 1236), (1676, 1036), (1651, 836), (1601, 636), (1526, 236), (1501, 100), (1489, 36), (1480, 0)]),
        District(name: "west park", zone: Park, polygon: [(436, 836), (636, 836), (636, 1036), (436, 1036)]),
        District(name: "boulevard park", zone: Park, polygon: [(1040, 1450), (1150, 1450), (1150, 1560), (1040, 1560)]),
        // Downtown: towers along the river mouth, between the south branch and the lake.
        District(name: "downtown", zone: Downtown, polygon: [(1640, 1636), (1906, 1636), (1950, 1836), (1950, 2048), (1640, 2048)]),
    ],

    roads: [
        // The city limits: north, west and south.
        Road(name: "north limits", class: Arterial, lanes: 2, points: [(100, 100), (1501, 100)]),
        Road(name: "west limits", class: Arterial, lanes: 2, points: [(100, 100), (100, 2009)]),
        Road(name: "south limits", class: Arterial, lanes: 2, points: [(100, 2009), (1951, 2009)]),
        // The shore drive, through the lakefront park from the north limits to downtown.
        Road(name: "shore drive", class: Arterial, lanes: 2, speed_kph: Some(80), sidewalk: false, points: [(1501, 100), (1526, 236), (1601, 636), (1651, 836), (1676, 1036), (1726, 1236), (1851, 1436), (1901, 1636), (1951, 1836), (1951, 2009)]),
        // The section-line grid, a mile apart: avenues running north and south...
        Road(name: "eighth avenue", class: Arterial, lanes: 2, points: [(436, 100), (436, 2009)]),
        Road(name: "seventh avenue", class: Arterial, lanes: 2, points: [(636, 100), (636, 2009)]),
        Road(name: "sixth avenue", class: Arterial, lanes: 2, points: [(836, 100), (836, 2009)]),
        Road(name: "fifth avenue", class: Arterial, lanes: 2, points: [(1036, 100), (1036, 2009)]),
        Road(name: "fourth avenue", class: Arterial, lanes: 2, points: [(1236, 100), (1236, 2009)]),
        Road(name: "third avenue", class: Arterial, lanes: 2, points: [(1436, 100), (1436, 2009)]),
        Road(name: "second avenue", class: Arterial, lanes: 2, points: [(1636, 1436), (1636, 2009)]),
        // ...and streets running east and west, from the west limits to the shore.
        Road(name: "line road", class: Arterial, lanes: 2, points: [(100, 236), (1526, 236)]),
        Road(name: "market street", class: Arterial, lanes: 2, points: [(100, 636), (1601, 636)]),
        Road(name: "crosstown", class: Arterial, lanes: 2, points: [(100, 836), (1651, 836)]),
        Road(name: "midway street", class: Arterial, lanes: 2, points: [(100, 1036), (1676, 1036)]),
        Road(name: "park street", class: Arterial, lanes: 2, points: [(100, 1236), (1726, 1236)]),
        Road(name: "old north road", class: Arterial, lanes: 2, points: [(100, 1436), (1851, 1436)]),
        Road(name: "mission street", class: Arterial, lanes: 2, points: [(100, 1636), (1901, 1636)]),
        Road(name: "center street", class: Arterial, lanes: 2, points: [(100, 1836), (1951, 1836)]),
        // The old trails, older than the grid. The ridge road leaves downtown north along the
        // old shore ridge; the north diagonal leaves it for the north-west corner of the
        // suburbs; the plank road runs from the river fork out to the north-west, through the
        // six-way corners where it meets the grid.
        Road(name: "ridge road", class: Arterial, lanes: 2, points: [(1811, 2009), (1811, 1436), (1661, 1236), (1561, 1036), (1500, 836)]),
        Road(name: "north diagonal", class: Arterial, lanes: 2, points: [(1786, 1403), (1636, 1236), (1436, 1036), (1236, 636), (1036, 236), (900, 100)]),
        Road(name: "plank road", class: Arterial, lanes: 2, points: [(1636, 1736), (1511, 1636), (1436, 1536), (1336, 1436), (1036, 1186), (636, 836), (486, 636), (236, 236), (134, 100)]),
        // The expressway out of downtown, a block south-west of the plank road, then off west.
        Road(name: "airport expressway", class: Highway, lanes: 2, sidewalk: false, ramps: ["midway street", "market street"], points: [(1560, 1836), (1560, 1780), (1440, 1707), (1365, 1607), (1265, 1507), (965, 1257), (565, 907), (415, 707), (100, 468)]),
    ],

    // The river, from the lake past downtown to its fork; the south branch; the north-west
    // branch up into the woods; and the straight channel cut north from it. Both northern
    // ones come out of culverts in the woods short of the north limits, clear of the bluff
    // along the edge.
    channels: [
        Channel(name: "river", line: [(2048, 1736), (1711, 1761)], width_m: 10, depth_m: 2.5, wet: true),
        Channel(name: "south branch", line: [(1711, 1761), (1736, 2048)], width_m: 9, depth_m: 2.5, wet: true),
        Channel(name: "north branch", line: [(1711, 1761), (1636, 1636), (1511, 1436), (1386, 1236), (1211, 1036), (1111, 836), (1061, 636), (1011, 536), (886, 436), (736, 236), (680, 148)], width_m: 8, depth_m: 2.5, wet: true),
        Channel(name: "north channel", line: [(1011, 536), (986, 236), (977, 150)], width_m: 7, depth_m: 2.5, wet: true),
    ],

    // On the plank road heading north-west toward the line road and the drive-in.
    start: Start(road: "plank road", along_m: 1700),
)
