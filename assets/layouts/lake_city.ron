    // The river, from the lake past downtown to its fork; the south branch; the north-west
    // branch up into the woods; and the straight channel cut north from it. Both northern
    // ones come out of culverts in the woods short of the north limits, clear of the bluff
    // along the edge.
    channels: [
        // realmap:channels begin
        Channel(name: "river", line: [(2048, 1799), (1791, 1830)], width_m: 10, depth_m: 2.5, wet: true),
        Channel(name: "south branch", line: [(1791, 1830), (1782, 2048)], width_m: 9, depth_m: 2.5, wet: true),
        Channel(name: "north branch", line: [(1791, 1830), (1744, 1709), (1702, 1592)], width_m: 8, depth_m: 2.5, wet: true),
        // realmap:channels end
    ],

    // On the plank road heading north-west toward the line road and the drive-in.
    // realmap:start begin
    start: Start(road: "road 23", along_m: 403),
