// The Bay Loop (docs/SCENARIOS.md, docs/LAYOUTS.md): a compressed Bay Area of the 2000s as one
// ring of districts around the water. The city on its hills at the north-west, a red bridge
// over the strait to the headlands, the headlands road round the north of the bay to the
// East Bay's college town and its hills, the long bay bridge back to the city; south from the
// city down the Peninsula (the ridge and its ridge road, the foothill freeway, the strip, the
// bayshore and its freeway) to the flat South Bay and the foothill village, with a causeway
// across the bay's south end. Every road meets another or ends at a lookout.
//
// Meters, x east, z south, (0, 0) the north-west corner; 32 x 32 chunks, 4096 m square.
Layout(
    id: "bay_loop",
    size_chunks: (32, 32),
    ground_m: 6,
    water_level_m: 0,
    edges: Edges(north: Ocean, east: Hills, south: Hills, west: Ocean),

    ridges: [
        // The Peninsula's spine, from behind the city to the south hills: ocean on one side,
        // the bay on the other.
        // It rises gently from the city and falls gently to the south hills, so the ridge
        // road can run its length.
        Ridge(name: "spine", line: [(760, 1600), (740, 1850), (720, 2150), (700, 2500), (655, 3000), (690, 3400), (780, 3800), (900, 4060)],
              heights_m: [20, 50, 88, 120, 120, 92, 48, 24], falloff_m: 400, relief_m: 14),
        Ridge(name: "headlands", line: [(480, 215), (1200, 200), (1900, 205)],
              heights_m: [44, 40, 30], falloff_m: 130, relief_m: 6),
        Ridge(name: "east hills", line: [(3720, 420), (3760, 1500), (3720, 2600), (3620, 3500)],
              height_m: 145, falloff_m: 470, relief_m: 14),
    ],
    peaks: [
        // The city's hills: the crests its grid is laid straight over, about as steep as its
        // streets can climb (`street_grade` in the `bay_area` zone rules).
        Peak(name: "high crest", at: (820, 1060), height_m: 48, falloff_m: 340),
        Peak(name: "north crest", at: (1300, 820), height_m: 34, falloff_m: 240),
        Peak(name: "south crest", at: (1180, 1320), height_m: 30, falloff_m: 230),
        Peak(name: "west crest", at: (560, 1260), height_m: 36, falloff_m: 240),
        Peak(name: "summit", at: (3740, 960), height_m: 115, falloff_m: 380),
    ],

    // One body of salt water: the ocean down the west side and across the north, through
    // the strait into the bay.
    water: [
        Water(kind: Sea, depth_m: 4.2, polygon: [
            (0, 0), (2300, 0), (2300, 90), (1700, 110), (1100, 92), (600, 120), (380, 200),
            (330, 300), (600, 362), (1000, 380), (1400, 372), (1800, 362),
            (2000, 420), (2350, 480), (2700, 560),
            (2950, 750), (3040, 1100), (3075, 1600), (3050, 2100), (2985, 2550), (2860, 2900),
            (2600, 3050), (2300, 3100), (2000, 3020),
            (1880, 2700), (1860, 2200), (1880, 1700), (1900, 1300), (1880, 950), (1800, 720),
            (1500, 605), (1100, 585), (700, 600), (420, 640),
            (360, 900), (330, 1400), (300, 2000), (320, 2600), (290, 3200), (300, 3700),
            (280, 4096), (0, 4096),
        ]),
    ],

    // Open hills unless a district says otherwise.
    default_zone: Hills,
    districts: [
        District(name: "east bay", zone: Suburb, polygon: [(2950, 650), (3450, 600), (3450, 3250), (2900, 3250)]),
        District(name: "college town", zone: Commercial, polygon: [(3060, 820), (3400, 820), (3400, 1160), (3060, 1160)]),
        District(name: "peninsula", zone: Suburb, polygon: [(1080, 1500), (1900, 1500), (1900, 3260), (1080, 3260)]),
        District(name: "bayshore", zone: Industrial, polygon: [(1640, 1620), (1900, 1620), (1900, 3000), (1640, 3000)]),
        District(name: "the strip", zone: Strip, polygon: [(1380, 1500), (1520, 1500), (1520, 3260), (1380, 3260)]),
        District(name: "university", zone: Park, polygon: [(1140, 2330), (1370, 2330), (1370, 2660), (1140, 2660)]),
        District(name: "south bay", zone: Suburb, polygon: [(1000, 3260), (3480, 3260), (3480, 3870), (1000, 3870)]),
        District(name: "office parks", zone: Industrial, polygon: [(2000, 3340), (2600, 3340), (2600, 3560), (2000, 3560)]),
        District(name: "village", zone: Suburb, polygon: [(820, 3380), (1060, 3380), (1060, 3640), (820, 3640)]),
        District(name: "city", zone: Residential, hilly: true, polygon: [(380, 610), (1860, 610), (1880, 1500), (340, 1500)]),
        District(name: "downtown", zone: Downtown, polygon: [(1500, 640), (1880, 640), (1890, 1060), (1500, 1060)]),
    ],

    roads: [
        // The loop: the bayshore freeway down the Peninsula, across the South Bay, the East
        // Bay's freeway up the shore and the bay bridge back to the city.
        Road(name: "bayshore freeway", class: Highway, lanes: 3, ramps: ["north cross", "college cross"], points: [
            (1820, 1000), (1800, 1500), (1780, 2200), (1760, 2750), (1760, 3300),
        ]),
        Road(name: "south loop", class: Arterial, lanes: 2, speed_kph: Some(80), points: [(1760, 3300), (2400, 3330), (3150, 3300)]),
        Road(name: "east freeway", class: Highway, lanes: 2, points: [(3150, 3300), (3150, 2750), (3150, 1800), (3130, 1000)]),
        Road(name: "bay bridge", class: Highway, lanes: 2, points: [(3130, 1000), (1820, 1000)]),

        // The city: a straight grid over its hills.
        Road(name: "crosstown", class: Arterial, lanes: 2, max_grade: Some(0.2), points: [(410, 1000), (1820, 1000)]),
        Road(name: "crest street", class: Collector, lanes: 1, max_grade: Some(0.25), points: [(440, 760), (1700, 760)]),
        Road(name: "vista street", class: Collector, lanes: 1, max_grade: Some(0.25), points: [(410, 1250), (1450, 1250)]),
        Road(name: "park avenue", class: Arterial, lanes: 2, max_grade: Some(0.2), points: [(390, 1450), (1802, 1460)]),
        Road(name: "waterfront", class: Arterial, lanes: 2, points: [(1000, 690), (1500, 705), (1820, 800), (1820, 1000)]),
        Road(name: "coast road", class: Rural, lanes: 1, sidewalk: false, max_grade: Some(0.14), points: [
            (440, 760), (410, 1000), (400, 1450), (380, 2000), (380, 2600), (400, 3200), (450, 3700), (820, 3850),
        ]),

        // The red bridge over the strait, the lookout and the headlands road round to the
        // East Bay.
        Road(name: "red bridge", class: Arterial, lanes: 2, max_grade: Some(0.2), suspension: true, points: [(1000, 1450), (1000, 320)]),
        Road(name: "lookout", class: Rural, lanes: 1, sidewalk: false, dead_end: true, points: [(1000, 320), (700, 300), (520, 230)]),
        Road(name: "headlands road", class: Rural, lanes: 1, sidewalk: false, speed_kph: Some(70), points: [
            (1000, 320), (1600, 315), (2200, 330), (2500, 400), (2900, 520), (3150, 700), (3136, 1100),
        ]),

        // The Peninsula: the ridge road, the foothill freeway, the strip and the cross
        // streets from the bay to the ridge.
        Road(name: "ridge road", class: Rural, lanes: 1, sidewalk: false, speed_kph: Some(70), max_grade: Some(0.14), points: [
            (800, 1452), (760, 1600), (740, 1850), (720, 2150), (700, 2500), (655, 3000), (690, 3400), (780, 3800), (820, 3850),
        ]),
        Road(name: "foothill freeway", class: Highway, lanes: 2, points: [
            (1100, 1453), (1050, 2000), (1000, 2600), (950, 3000), (950, 3300),
        ]),
        Road(name: "old highway", class: Arterial, lanes: 2, speed_kph: Some(55), points: [(1450, 1000), (1450, 3300)]),
        Road(name: "north cross", class: Arterial, lanes: 1, dead_end: true, points: [(1043, 2100), (1840, 2100)]),
        Road(name: "college cross", class: Arterial, lanes: 1, dead_end: true, points: [(1008, 2500), (1840, 2500)]),
        Road(name: "south cross", class: Arterial, lanes: 1, dead_end: true, points: [(975, 2700), (1700, 2700)]),

        // The causeway across the bay's south end.
        Road(name: "causeway", class: Arterial, lanes: 2, speed_kph: Some(80), points: [(1761, 2750), (3150, 2750)]),

        // The South Bay: a flat grid, the foothill village and its climb to the ridge road.
        Road(name: "south road", class: Arterial, lanes: 2, points: [(950, 3300), (1760, 3300)]),
        Road(name: "village road", class: Collector, lanes: 1, max_grade: Some(0.14), points: [(820, 3850), (950, 3650), (950, 3300)]),
        Road(name: "foothill road", class: Arterial, lanes: 2, points: [(950, 3650), (1500, 3800), (3300, 3800), (3150, 3300)]),
        Road(name: "shore street", class: Arterial, lanes: 1, points: [(1760, 3300), (1760, 3800)]),
        Road(name: "east cross", class: Arterial, lanes: 1, points: [(2400, 3330), (2400, 3800)]),

        // The East Bay: streets off the loop to the hills, and the road up to the overlook.
        Road(name: "hillside", class: Arterial, lanes: 1, points: [(3450, 1212), (3450, 3200), (3300, 3800)]),
        Road(name: "flats avenue", class: Arterial, lanes: 1, points: [(3145, 1600), (3450, 1600)]),
        Road(name: "hill cross", class: Arterial, lanes: 1, points: [(3150, 2200), (3450, 2200)]),
        Road(name: "overlook road", class: Rural, lanes: 1, sidewalk: false, dead_end: true, max_grade: Some(0.14), points: [
            (3138, 1300), (3400, 1250), (3560, 1200), (3520, 1060), (3660, 1010), (3720, 960),
        ]),
    ],

    start: Start(road: "crest street", along_m: 160),
)
