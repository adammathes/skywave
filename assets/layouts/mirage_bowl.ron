    // realmap:terrain end

    peaks: [
        Peak(name: "summit", at: (1900, 110), height_m: 300, falloff_m: 520),
        // A spur of the front range with a lookout over the flats.
        Peak(name: "observatory spur", at: (1100, 420), height_m: 120, falloff_m: 230),
        // The lone knoll in the flats, a park with a road to its top.
        Peak(name: "the knoll", at: (720, 2000), height_m: 55, falloff_m: 230),
    ],

    // Everything no district covers is open hillside: the rim and the knoll.
    default_zone: Hills,
    districts: [
        // The floor stops at the avenues that frame it; past them is open hillside, so no street
        // runs off into the brush and stops.
        District(name: "the flats", zone: Residential, polygon: [(250, 680), (2800, 680), (2800, 2680), (250, 2680)]),
        District(name: "knoll park", zone: Park, polygon: [(560, 1860), (880, 1860), (880, 2150), (560, 2150)]),
        District(name: "the yards", zone: Industrial, polygon: [(250, 2680), (2800, 2680), (2800, 2950), (250, 2950)]),
        // Strip corridors along the boulevards and the old road.
        District(name: "mirage strip", zone: Strip, polygon: [(250, 1180), (2800, 1180), (2800, 1320), (250, 1320)]),
        District(name: "tamarisk strip", zone: Strip, polygon: [(880, 1790), (2800, 1790), (2800, 1910), (880, 1910)]),
        District(name: "old road strip", zone: Strip, polygon: [(360, 2930), (490, 2970), (1680, 670), (1550, 630)]),
        District(name: "foothill strip", zone: Strip, polygon: [(250, 680), (2800, 680), (2800, 760), (250, 760)]),
        // A few towers on the summit avenue, framed by the mountains behind them.
        District(name: "downtown", zone: Downtown, polygon: [(1780, 1330), (2260, 1330), (2260, 1700), (1780, 1700)]),
        District(name: "the junction", zone: Commercial, polygon: [(1180, 1550), (1500, 1550), (1500, 1800), (1180, 1800)]),
    ],

    roads: [
        // The boulevards, west to east.
        Road(name: "foothill boulevard", class: Arterial, lanes: 2, points: [(250, 680), (2800, 680)]),
        Road(name: "mirage boulevard", class: Arterial, lanes: 3, speed_kph: Some(70), points: [(250, 1250), (2800, 1250)]),
        Road(name: "tamarisk boulevard", class: Arterial, lanes: 2, points: [(250, 1850), (2800, 1850)]),
        // Oleander stops at palm avenue: the airfield lies beyond.
        Road(name: "oleander avenue", class: Arterial, lanes: 2, points: [(250, 2450), (2400, 2450)]),
        Road(name: "yard road", class: Arterial, lanes: 1, points: [(250, 2950), (2800, 2950)]),

        // The avenues, south to north: every one ends at the mountain front.
        Road(name: "west avenue", class: Arterial, lanes: 2, points: [(250, 2950), (250, 680)]),
        Road(name: "canyon avenue", class: Arterial, lanes: 2, points: [(800, 2950), (800, 680)]),
        Road(name: "summit avenue", class: Arterial, lanes: 3, speed_kph: Some(70), points: [(1900, 2950), (1900, 680)]),
        Road(name: "palm avenue", class: Arterial, lanes: 2, points: [(2400, 2950), (2400, 680)]),
        Road(name: "east avenue", class: Arterial, lanes: 2, points: [(2800, 2950), (2800, 680)]),
        Road(name: "market street", class: Collector, lanes: 1, points: [(1350, 2450), (1350, 1250)]),

        // The freeway across the middle of the floor, under downtown's towers: every street
        // crosses it on a deck, the main avenues get diamonds.
        Road(name: "valley freeway", class: Highway, lanes: 3, speed_kph: Some(105),
             ramps: ["canyon avenue", "summit avenue", "palm avenue"],
             points: [(250, 1550), (2800, 1550)]),

        // The old road, older than the grid, on a diagonal toward the summit.
        Road(name: "old road", class: Arterial, lanes: 2, speed_kph: Some(65), points: [(425, 2950), (1615, 680)]),

        // Up into the rim: the canyon road to the spur's lookout, the summit road, the knoll.
        Road(name: "observatory road", class: Rural, lanes: 1, sidewalk: false, dead_end: true, max_grade: Some(0.14), points: [
            (800, 680), (820, 560), (920, 500), (1020, 470), (1100, 430),
        ]),
        Road(name: "summit road", class: Rural, lanes: 1, sidewalk: false, dead_end: true, max_grade: Some(0.14), points: [
            (1900, 680), (1900, 560), (2050, 470), (1960, 390), (2120, 300), (2000, 220),
        ]),
        Road(name: "knoll drive", class: Collector, lanes: 1, sidewalk: false, dead_end: true, max_grade: Some(0.14), points: [
            (800, 1850), (760, 1930), (720, 2000),
        ]),
    ],

    // The wash: a concrete flood channel from the mountain front across the floor and out
    // through the yards. Every road bridges it.
    channels: [
        Channel(name: "the wash", line: [(1300, 560), (1250, 1000), (1160, 1700), (1100, 2400), (1050, 3072)],
                width_m: 14, depth_m: 5),
    ],

    // The rail line through the yards, in from the south and out again, across the avenues
    // at grade and over the wash on a bridge, with two spurs into the sheds.
    rail: Some(Rail(
        line: [(300, 3072), (306, 2960), (334, 2876), (390, 2822), (470, 2800),
               (2600, 2800), (2680, 2822), (2736, 2876), (2764, 2960), (2770, 3072)],
        spurs: [
            [(1380, 2800), (1440, 2826), (1700, 2826)],
            [(2000, 2800), (2060, 2774), (2320, 2774)],
        ],
    )),

    // The airfield at the south-east corner of the flats, off tamarisk boulevard: its runway
    // is the drag strip.
    airfield: Some(Airfield(runway: ((2620, 1960), (2620, 2740)), runway_m: 30, width_m: 150, taxiway: (2620, 1850))),

    // The garage, the stands, the roadside landmarks, the tunnel and the lookouts' turnouts.
    set_pieces: true,

    start: Start(road: "summit avenue", along_m: 700),
)
