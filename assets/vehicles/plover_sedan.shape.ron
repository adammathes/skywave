        (1.28, 0.92), (1.70, 1.22), (2.02, 1.38), (2.20, 1.42), (2.90, 1.43), (3.30, 1.38),
        (3.60, 1.24), (3.95, 1.06), (4.05, 1.04), (4.60, 1.03), (4.76, 0.99), (4.85, 0.90),
        (4.85, 0.34), (4.72, 0.24), (4.20, 0.19), (0.80, 0.18), (0.16, 0.22), (0.00, 0.32),
