        mirror_pos: (1.92, 1.62),
        seat: (2.42, 0.76),
        driver_offset: 0.42,
        rear_seat: false,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: red vinyl with a lighter red insert
