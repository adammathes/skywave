        side: [(1.64, 2.14)],
    ),
    wheels: Wheels(radius: 0.46, width: 0.26, arch_clearance: 0.05, front_x: 1.04, rear_x: 5.64, track: 1.92),
    front: Front(lights: Rect, grille: Wide, bumper: Body, bumper_y: (0.48, 0.68)),
    rear: Rear(lights: Dual, spoiler: None, bumper: Rubber, bumper_y: (0.86, 1.02)),
    seams: Seams(hood: true, trunk: true, doors: 2, hood_width: 0.80, creases: [(0.10, 0.92, 2.20, 0.94)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 2, exhaust: Single, antenna: None, rims: Steel, hubcaps: false),
    details: [MudFlaps, SideStripe, Badge(Bar)],
    // White, white over red, white over blue, yellow, white over dark green, silver, tan.
    palette: ["#eeede8", "#eeede8/#a8202a", "#eeede8/#22407a", "#e2b51e", "#eeede8/#243f30", "#b8bcc0", "#cbb896"],
    accent: "#a8202a",
