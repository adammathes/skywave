// Sledge Box Truck body: a late-90s medium-duty box truck, a conventional cab with a tall
// cargo box behind it.
//
// Intent: the delivery truck at every loading dock. A short square hood with a wide grille
// between rectangular lamps, an upright windshield, a narrow two-door cab, then a tall,
// wider, flat-sided aluminum box standing on the frame, its floor well over the rear
// wheels, a roll-up door at the back. Body-colored bumpers, mud flaps, steel wheels.
// Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "sledge_box_truck",
    side: [
        (0.00, 1.00), (0.05, 1.10), (0.20, 1.18), (0.90, 1.26), (1.00, 1.30), (1.50, 2.26),
        (1.60, 2.34), (2.18, 2.36), (2.22, 2.34), (2.28, 3.22), (2.36, 3.30), (7.30, 3.30),
        (7.38, 3.24), (7.40, 3.16),
        (7.40, 1.06), (7.30, 1.02), (2.46, 1.02), (2.38, 0.56), (0.14, 0.52), (0.00, 0.62),
    ],
    plan: [
        (0.00, 0.94), (0.06, 1.00), (0.30, 1.04), (2.20, 1.05), (2.26, 1.20), (2.34, 1.22),
        (7.32, 1.22), (7.40, 1.20),
    ],
    belt: [(1.00, 1.30), (2.18, 1.34), (2.30, 2.96), (7.40, 2.96)],
    section: Section(shoulder: 0.98, tumblehome_deg: 4, greenhouse_frac: 0.94, crown: 0.02, tuck: 0.02),
    glass: Glass(
        windshield: (1.02, 1.56),
