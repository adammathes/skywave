// Petrel Roadster body: an early-2000s tiny mid-engined two-seat roadster.
//
// Intent: small, low and alive. A short rounded nose with round lamps and a wide mouth, a
// raked windshield in a black frame, bare door tops with strakes into an intake on each
// flank ahead of the rear wheel, the engine under a long, rising deck behind the seats,
// round tail lamps and a wide stance on small alloys. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "petrel_roadster",
    side: [
        (0.00, 0.40), (0.05, 0.50), (0.25, 0.60), (1.05, 0.76), (1.10, 0.77),
        (1.50, 1.10), (1.56, 0.80), (2.80, 0.88), (3.40, 0.92), (3.70, 0.90), (3.79, 0.84),
        (3.79, 0.36), (3.65, 0.25), (3.20, 0.15), (0.55, 0.14), (0.10, 0.17), (0.00, 0.26),
    ],
    plan: [
        (0.00, 0.56), (0.15, 0.74), (0.55, 0.83), (1.00, 0.84), (1.90, 0.81), (2.80, 0.86),
        (3.50, 0.86), (3.79, 0.78),
    ],
    belt: [(1.10, 0.77), (1.56, 0.80), (2.80, 0.88), (3.40, 0.915)],
    section: Section(shoulder: 0.92, tumblehome_deg: 26, greenhouse_frac: 0.70, crown: 0.04, tuck: 0.05),
    glass: Glass(
        windshield: (1.12, 1.49),
        // No side glass; the backlight range is the boot behind the seats.
        backlight: (2.62, 2.92),
        side: [],
    ),
    wheels: Wheels(radius: 0.30, width: 0.20, arch_clearance: 0.05, front_x: 0.78, rear_x: 3.08, track: 1.46),
    front: Front(lights: Round, grille: Wide, bumper: Body, bumper_y: (0.22, 0.34)),
    rear: Rear(lights: Round, spoiler: None, bumper: Body, bumper_y: (0.30, 0.44)),
    seams: Seams(hood: true, trunk: true, doors: 2, hood_width: 0.78, creases: [(0.20, 0.48, 3.70, 0.56)]),
    parts: Parts(mirrors: Door, handles: Flush, wipers: 2, exhaust: Dual, antenna: Mast, rims: Alloy5, hubcaps: false),
    details: [SideStrakes, BlackTrim, Badge(Circle)],
    roof: Roof(kind: Convertible(top: Down)),
    // Racing green, bright yellow, silver, orange, white, black.
    palette: ["#1d4a2e", "#e8c21a", "#bcc0c4", "#e0661c", "#efeee9", "#151618"],
    accent: "#18181a",
    interior: InteriorShape(
        dash_height: 0.72,
        dash_x: 1.28,
        wheel_pos: (1.64, 0.56),
        wheel_radius: 0.17,
        column_angle_deg: 20,
        mirror_pos: (1.46, 1.04),
        seat: (1.92, 0.30),
        driver_offset: 0.34,
        rear_seat: false,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: bare black dash, black cloth shells,
        // thin black carpet, bare alloy sills in the trim, white dials lit amber.
        colors: ["#18191b", "#232427", "#1b1c1e", "#2e2f32", "#6e7176", "#d8d4c8"],
        display: "#ffb030",
        insert: "#34363a",
        piping: "#18191b",
        dash_top: "#1a1b1d",
        applique: Brushed,
        manual: true,
    ),
)
