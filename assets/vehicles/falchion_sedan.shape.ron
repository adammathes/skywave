    id: "falchion_sedan",
    side: [
        (0.00, 0.50), (0.04, 0.60), (0.12, 0.70), (1.10, 0.88), (1.18, 0.90),
        (1.78, 1.33), (1.90, 1.37), (2.90, 1.36), (3.48, 1.06), (3.56, 1.04),
        (4.32, 1.02), (4.43, 0.94),
        (4.43, 0.32), (4.28, 0.22), (3.80, 0.17), (0.70, 0.16), (0.12, 0.20), (0.00, 0.30),
    ],
