    wheels: Wheels(radius: 0.32, width: 0.22, arch_clearance: 0.05, front_x: 0.86, rear_x: 3.38, track: 1.48),
    front: Front(lights: Rect, grille: Slot, bumper: Body, bumper_y: (0.24, 0.42)),
    rear: Rear(lights: Dual, spoiler: TallWing, bumper: Body, bumper_y: (0.32, 0.48)),
    seams: Seams(hood: true, trunk: true, doors: 4, hood_width: 0.80, creases: [(0.25, 0.64, 4.34, 0.70)]),
    parts: Parts(mirrors: Door, handles: Flush, wipers: 2, exhaust: Single, antenna: None, rims: Mesh, hubcaps: false),
    details: [HoodScoop, MudFlaps, BlackTrim, Badge(Diamond)],
    // Rally blue, white, black, silver, red, dark green.
    palette: ["#1e3f9a", "#efeee9", "#141518", "#b6babf", "#a3141c", "#1f3b2b"],
