        (2.12, 1.11), (2.20, 1.13), (2.56, 1.12), (3.02, 0.97), (3.20, 0.95),
        (4.16, 0.95), (4.23, 0.92),
        (4.23, 0.32), (4.05, 0.22), (3.60, 0.17), (0.70, 0.16), (0.14, 0.20), (0.00, 0.30),
    ],
