// Prescott Landau body: a late-70s-into-80s mid-size sedan with a landau vinyl roof.
//
// Intent: a crisp three-box sedan dressed up. Two pairs of square lamps either side of an
// egg-crate grille, a long hood, a tall roof under a textured vinyl cover with small opera
// windows in wide rear pillars, a short trunk and a squared tail. Chrome bumpers, belt
// molding and rockers, turbine wheels. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "prescott_landau",
    side: [
        (0.00, 0.78), (0.05, 0.84), (1.30, 0.89), (1.38, 0.91), (1.94, 1.37),
        (2.02, 1.38), (3.22, 1.37), (3.30, 1.35), (3.76, 0.97), (3.84, 0.96),
        (4.92, 0.95), (4.97, 0.93), (5.00, 0.89),
        (5.00, 0.31), (4.85, 0.24), (4.30, 0.20), (1.00, 0.19), (0.12, 0.23), (0.00, 0.31),
    ],
    plan: [
        (0.00, 0.87), (0.06, 0.90), (0.35, 0.91), (4.80, 0.91), (4.96, 0.90), (5.00, 0.88),
    ],
    belt: [(1.38, 0.91), (5.00, 0.94)],
    section: Section(shoulder: 0.95, tumblehome_deg: 12, greenhouse_frac: 0.84, crown: 0.03, tuck: 0.03),
    glass: Glass(
        windshield: (1.40, 1.92),
        backlight: (3.30, 3.76),
        side: [(1.48, 2.46), (2.56, 2.96), (3.06, 3.18)],
    ),
    wheels: Wheels(radius: 0.33, width: 0.20, arch_clearance: 0.05, front_x: 0.98, rear_x: 3.74, track: 1.50),
    front: Front(lights: Quad, grille: Egg, bumper: Chrome, bumper_y: (0.30, 0.46)),
    rear: Rear(lights: Dual, spoiler: None, bumper: Chrome, bumper_y: (0.31, 0.46)),
    seams: Seams(hood: true, trunk: true, doors: 4, hood_width: 0.82, creases: [(0.10, 0.70, 4.95, 0.72)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 2, exhaust: Single, antenna: Mast, rims: Turbine, hubcaps: false, whitewalls: true),
    details: [ChromeTrim, VinylRoof, Badge(Circle)],
    // Champagne, light blue, jade, white, maroon, silver, cream over brown.
    palette: ["#cdbb96", "#9db3c8", "#4b7a66", "#ecebe4", "#6c2230", "#bcbec0", "#e6dcc0/#5c4230"],
    // The vinyl roof: dark brown.
    accent: "#3a2a24",
    interior: InteriorShape(
        dash_height: 0.93,
        dash_x: 1.72,
        wheel_pos: (2.14, 0.75),
        wheel_radius: 0.195,
        column_angle_deg: 28,
        mirror_pos: (1.90, 1.30),
        seat: (2.64, 0.47),
        driver_offset: 0.39,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: jade-green velour with lighter
        // inserts and cream piping, green carpet, a wood band, amber-lit dials.
        colors: ["#22403a", "#2f5a4a", "#24443a", "#c8c6b4", "#2c4c42", "#c8a860"],
        display: "#ffae3b",
        insert: "#4a7d68",
