// Kestrel Sedan: the early-90s American family sedan that made the whole street go round:
// a front-drive midsize with a smooth aero body, a V6 and a column-shift automatic.
//
// Intent: the car every Lake City block has two of. Soft, quiet and easy: a mild V6 with
// enough torque to get across an intersection, a four-speed automatic, light steering and a
// floaty ride. Understeers early and gently. The family car to start in.
//
// Layout and units: docs/VEHICLES.md and crates/vehicle/src/spec.rs.
VehicleSpec(
    id: "kestrel_sedan",
    name: "Kestrel Sedan",
    era: Nineties,
    year: 1992,
    class: Sedan,

    mass_kg: 1420,
    dims_m: (4.80, 1.80, 1.38),    // length, width, height
    wheelbase_m: 2.69,
    track_m: 1.55,
    cg_height_m: 0.52,
    cg_fore_aft: 0.40,

    engine: Engine(
        idle_rpm: 700,
        redline_rpm: 5600,
        torque_nm: [(1000, 180), (2400, 215), (3200, 224), (4400, 210), (5600, 170)],
    ),
    gears: [2.77, 1.54, 1.0, 0.75],
    final_drive: 3.77,
    reverse: 2.26,
    shift_ms: 400,
    auto: true,
    drive: Front,

    tires: Tires(grip_lat: 0.843, grip_long: 0.95, load_sens: 0.1, slip_peak_deg: 8.0),
    suspension: Susp(spring_n_m: 24000, damper: 2200, travel_m: 0.18, antiroll: 0.25),
    steering: Steer(max_deg: 34, speed_sens: 0.55, return_rate: 6.5),
    brakes: Brakes(max_nm: 3000, bias_front: 0.68, abs: true, handbrake_nm: 2200),
    aero: Aero(cd: 0.337, frontal_m2: 2.08, downforce_coef: 0.0),
    feel: Feel(oversteer_bias: -0.2, body_roll: 0.65, engine_sound: "v6", shift_jerk: 0.1),
    interior: Interior(
        dash: "sport_90s",
        gauges: [Speedo(0, 120, mph), Tach(0, 6000)],
        radio: "digital_green",
    ),
    shape: "kestrel_sedan.shape.ron",
)
