// Longbow Targa: the front-engined American V8 sports car late in its run, early 90s.
//
// Intent: the Longbow Coupe grown up. The same stiff, wide, low car, now with a much
// stronger small V8, ABS and a roof panel that lifts out. Fat torque everywhere, a
// four-speed automatic and huge tires: it grips like a race car on a smooth road and rides
// like one too. Stable, a touch of understeer, the tail out only on a big throttle. A Lake
// City hero.
//
// Layout and units: docs/VEHICLES.md and crates/vehicle/src/spec.rs.
VehicleSpec(
    id: "longbow_targa",
    name: "Longbow Targa",
    era: Nineties,
    year: 1993,
    class: Sports,

    mass_kg: 1518,
    dims_m: (4.48, 1.80, 1.19),    // length, width, height
    wheelbase_m: 2.44,
    track_m: 1.52,
    cg_height_m: 0.46,
    cg_fore_aft: 0.49,             // 51% front

    engine: Engine(
        idle_rpm: 700,
        redline_rpm: 5700,
        torque_nm: [(1000, 360), (2400, 450), (3200, 474), (4400, 460), (5000, 430), (5700, 360)],
    ),
    gears: [3.06, 1.63, 1.0, 0.7],
    final_drive: 3.07,
    reverse: 2.3,
    shift_ms: 300,
    auto: true,
    drive: Rear,

    tires: Tires(grip_lat: 1.355, grip_long: 1.08, load_sens: 0.08, slip_peak_deg: 7.0),
    suspension: Susp(spring_n_m: 40000, damper: 3600, travel_m: 0.13, antiroll: 0.5),
    steering: Steer(max_deg: 31, speed_sens: 0.6, return_rate: 11.0),
    brakes: Brakes(max_nm: 3600, bias_front: 0.62, abs: true, handbrake_nm: 3000),
    aero: Aero(cd: 0.39, frontal_m2: 2.04, downforce_coef: 0.01),
    feel: Feel(oversteer_bias: 0.02, body_roll: 0.25, engine_sound: "v8_lazy", shift_jerk: 0.2),
    interior: Interior(
        dash: "sport_90s",
        gauges: [Speedo(0, 160, mph), Tach(0, 6000)],
        radio: "amber_seek",
    ),
    shape: "longbow_targa.shape.ron",
)
