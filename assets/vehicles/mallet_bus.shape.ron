// Mallet Bus body: the forty-foot city transit bus.
//
// Intent: a long white box with a face of glass. A flat front with a tall, slightly raked
// windshield over a rubber bumper and square lamps, a flat roof, a row of big side windows
// the whole way back over a stripe in the transit colors, a small rear window over the
// engine bay and its lamps. Mud flaps, plain steel wheels. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "mallet_bus",
    side: [
        (0.00, 0.62), (0.04, 1.12), (0.30, 2.94), (0.44, 3.03), (0.64, 3.05), (11.96, 3.05),
        (12.12, 3.00), (12.20, 2.86),
        (12.20, 0.56), (12.08, 0.42), (0.14, 0.38), (0.00, 0.46),
    ],
    plan: [
        (0.00, 1.20), (0.06, 1.28), (0.20, 1.30), (12.10, 1.30), (12.20, 1.26),
    ],
    belt: [(0.05, 1.14), (0.60, 1.40), (12.20, 1.44)],
    section: Section(shoulder: 0.98, tumblehome_deg: 3, greenhouse_frac: 0.95, crown: 0.03, tuck: 0.02),
    glass: Glass(
        windshield: (0.06, 0.40),
        backlight: (12.14, 12.20),
        side: [(0.60, 1.60), (2.90, 5.00), (5.20, 7.40), (7.60, 9.80), (10.00, 11.70)],
    ),
    wheels: Wheels(radius: 0.50, width: 0.30, arch_clearance: 0.05, front_x: 2.30, rear_x: 9.50, track: 2.10),
    front: Front(lights: Rect, grille: None, bumper: Rubber, bumper_y: (0.40, 0.66)),
    rear: Rear(lights: Dual, spoiler: None, bumper: Rubber, bumper_y: (0.44, 0.70)),
    seams: Seams(hood: false, trunk: true, doors: 2, hood_width: 0.80, creases: [(0.20, 1.10, 12.10, 1.14)]),
    parts: Parts(mirrors: Fender, handles: Flush, wipers: 2, exhaust: Single, antenna: None, rims: Steel, hubcaps: false),
    details: [MudFlaps, SideStripe],
    // White over the transit colors (a red and blue band, the stripe in the accent), plain
    // white.
    palette: ["#eeede8", "#eeede8/#2a4a8a", "#eeede8"],
    accent: "#b0202a",
    interior: InteriorShape(
        dash_height: 1.30,
        dash_x: 0.50,
        wheel_pos: (0.90, 1.24),
        wheel_radius: 0.24,
        column_angle_deg: 50,
        mirror_pos: (0.50, 2.70),
        seat: (1.30, 1.00),
        driver_offset: 0.70,
        rear_seat: false,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: gray plastic, orange seats, a black
        // rubber floor, cream panels, amber-lit dials.
        colors: ["#2c2e32", "#c86a2a", "#26272a", "#d8d2c0", "#a8a49a", "#b0b0b0"],
        display: "#ffae3b",
        insert: "#b85e24",
        piping: "#2c2d30",
        dash_top: "#2c2d30",
    ),
)
