        (3.60, 1.07), (3.68, 1.06), (4.28, 1.05), (4.38, 1.00), (4.42, 0.92),
        (4.42, 0.35), (4.30, 0.25), (3.85, 0.19), (0.75, 0.18), (0.14, 0.22), (0.00, 0.35),
