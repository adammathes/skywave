// Goshawk Turbo body: a mid-2000s compact premium sport sedan.
//
// Intent: tidy, taut and expensive-looking without shouting. A short nose with slim
// rectangular lamps either side of a broad grille, a hood that rises to a steep windshield,
// a roof arched in one smooth curve over a four-door cabin, a short high deck, wide tail
// lamps, a crisp line low along the flanks and five-spoke alloys. Mostly silver, as the
// Peninsula's lots were. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "goshawk_turbo",
    side: [
        (0.00, 0.70), (0.04, 0.79), (0.12, 0.84), (0.30, 0.88), (0.70, 0.92), (1.22, 0.97),
        (1.92, 1.39), (2.12, 1.43), (2.50, 1.45), (2.95, 1.42), (3.58, 1.13), (3.66, 1.12),
        (4.44, 1.12), (4.56, 1.06), (4.58, 0.96),
        (4.58, 0.40), (4.45, 0.27), (3.95, 0.20), (0.85, 0.19), (0.15, 0.24), (0.00, 0.38),
    ],
    plan: [
        (0.00, 0.64), (0.06, 0.79), (0.25, 0.865), (1.00, 0.885), (4.00, 0.885), (4.40, 0.87),
        (4.58, 0.80),
    ],
    belt: [(1.24, 0.96), (2.45, 1.00), (3.58, 1.08)],
    section: Section(shoulder: 0.80, tumblehome_deg: 24, greenhouse_frac: 0.72, crown: 0.07, tuck: 0.07),
    glass: Glass(
        windshield: (1.26, 1.92),
        backlight: (2.95, 3.56),
        side: [(1.46, 2.45), (2.55, 3.12)],
    ),
    wheels: Wheels(radius: 0.33, width: 0.235, arch_clearance: 0.025, front_x: 0.92, rear_x: 3.57, track: 1.52),
    front: Front(lights: Swept, grille: Wide, bumper: Body, bumper_y: (0.22, 0.47)),
    rear: Rear(lights: Wrap, spoiler: Lip, bumper: Body, bumper_y: (0.30, 0.60)),
    seams: Seams(hood: true, trunk: true, doors: 4, hood_width: 0.82, creases: [(0.20, 0.70, 4.50, 0.78)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 2, exhaust: Dual, antenna: None, rims: Split, hubcaps: false),
    details: [Badge(Circle)],
    // Light silver, quartz gray, dark silver, black, deep blue pearl, white.
    palette: ["#c0c3c7", "#a8acb1", "#7d8086", "#1a1b1e", "#2b3a55", "#e9e8e3"],
    accent: "#141416",
    interior: InteriorShape(
        dash_height: 0.88,
        dash_x: 1.56,
        wheel_pos: (2.00, 0.72),
        wheel_radius: 0.18,
        column_angle_deg: 24,
        mirror_pos: (1.86, 1.28),
        seat: (2.50, 0.48),
        driver_offset: 0.37,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: black dash, dark gray cloth sport
