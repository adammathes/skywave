        wheel_pos: (2.00, 0.72),
        wheel_radius: 0.18,
        column_angle_deg: 24,
        mirror_pos: (1.86, 1.28),
        seat: (2.50, 0.48),
        driver_offset: 0.37,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: black dash, dark gray cloth sport
