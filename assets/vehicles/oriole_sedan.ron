// Oriole Sedan: the mid-90s imported midsize sedan, front drive with a smooth, revvy
// four-cylinder: the sensible car that never breaks.
//
// Intent: light, tidy and eager. A free-revving four with little low-down torque, a
// four-speed automatic, firm springs and quick steering: it feels smaller than it is, turns
// in crisply, understeers mildly at the limit and is happiest near its redline.
//
// Layout and units: docs/VEHICLES.md and crates/vehicle/src/spec.rs.
VehicleSpec(
    id: "oriole_sedan",
    name: "Oriole Sedan",
    era: Nineties,
    year: 1994,
    class: Sedan,

    mass_kg: 1330,
    dims_m: (4.68, 1.78, 1.39),    // length, width, height
    wheelbase_m: 2.72,
    track_m: 1.53,
    cg_height_m: 0.50,
    cg_fore_aft: 0.40,

    engine: Engine(
        idle_rpm: 750,
        redline_rpm: 6500,
        torque_nm: [(1000, 150), (2500, 180), (4000, 198), (5200, 192), (6500, 160)],
    ),
    gears: [2.72, 1.53, 0.98, 0.71],
    final_drive: 4.2,
    reverse: 1.95,
    shift_ms: 360,
    auto: true,
    drive: Front,

    tires: Tires(grip_lat: 0.856, grip_long: 0.98, load_sens: 0.1, slip_peak_deg: 7.5),
    suspension: Susp(spring_n_m: 28000, damper: 2600, travel_m: 0.16, antiroll: 0.3),
    steering: Steer(max_deg: 34, speed_sens: 0.55, return_rate: 8.0),
    brakes: Brakes(max_nm: 3100, bias_front: 0.68, abs: true, handbrake_nm: 2200),
    aero: Aero(cd: 0.34, frontal_m2: 2.02, downforce_coef: 0.0),
    feel: Feel(oversteer_bias: -0.1, body_roll: 0.5, engine_sound: "i4", shift_jerk: 0.1),
    interior: Interior(
        dash: "sport_90s",
        gauges: [Speedo(0, 130, mph), Tach(0, 8000)],
        radio: "digital_green",
    ),
    shape: "oriole_sedan.shape.ron",
)
