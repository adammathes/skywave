// Palisade Wagon body: a full-size early-80s family wagon.
//
// Intent: long and square. A tall flat nose with a wide chrome grille between two pairs
// of square sealed-beam lamps, a long flat hood, an upright windshield, a roof that runs
// all the way back over the cargo bay to a near-vertical tailgate, four doors, wood-grain
// side panels with a light surround, chrome bumpers and belt molding, a roof rack and big
// chrome wheel covers. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "palisade_wagon",
    side: [
        (0.00, 0.80), (0.05, 0.86), (1.30, 0.90), (1.40, 0.92), (2.00, 1.40),
        (2.12, 1.44), (4.95, 1.44), (5.14, 1.42), (5.22, 0.98), (5.25, 0.95),
        (5.25, 0.32), (5.10, 0.25), (4.50, 0.21), (1.00, 0.20), (0.12, 0.24), (0.00, 0.30),
    ],
    plan: [
        (0.00, 0.90), (0.08, 0.935), (0.40, 0.95), (5.00, 0.95), (5.20, 0.935), (5.25, 0.92),
    ],
    belt: [(1.40, 0.93), (5.25, 0.96)],
    section: Section(shoulder: 0.95, tumblehome_deg: 9, greenhouse_frac: 0.86, crown: 0.03, tuck: 0.03),
    glass: Glass(
        windshield: (1.42, 1.98),
        backlight: (5.14, 5.22),
        side: [(1.50, 2.62), (2.74, 3.70), (3.82, 4.95)],
    ),
    wheels: Wheels(radius: 0.34, width: 0.20, arch_clearance: 0.05, front_x: 0.98, rear_x: 3.93, track: 1.56),
    front: Front(lights: Quad, grille: Wide, bumper: Chrome, bumper_y: (0.30, 0.46)),
    rear: Rear(lights: Dual, spoiler: None, bumper: Chrome, bumper_y: (0.30, 0.45)),
    seams: Seams(hood: true, trunk: true, doors: 4, hood_width: 0.86, creases: [(0.15, 0.70, 5.10, 0.72)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 2, exhaust: Single, antenna: Mast, rims: Steel, hubcaps: true),
    details: [WoodPanel, ChromeTrim, RoofRack, Badge(Bar)],
    // Champagne, maroon, forest green, powder blue, cream, chocolate.
    palette: ["#c7b89a", "#6b2d26", "#3d4a3c", "#8aa0b0", "#e8e3d3", "#5a4632"],
    accent: "#8a6a48",
    interior: InteriorShape(
        dash_height: 0.96,
        dash_x: 1.78,
        wheel_pos: (2.20, 0.80),
        wheel_radius: 0.195,
        column_angle_deg: 28,
        mirror_pos: (1.92, 1.33),
        seat: (2.68, 0.50),
        driver_offset: 0.40,
        rear_seat: true,
        dials: 1,
        // Dash, seats, carpet, headliner, trim, accent (tan velour, woodgrain-era browns).
        colors: ["#6a5440", "#a07a52", "#5a4632", "#c9b99a", "#7a6248", "#b08a5a"],
        display: "#ffae3b",
    ),
)
