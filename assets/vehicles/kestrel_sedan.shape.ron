        (1.30, 0.91), (1.76, 1.24), (2.06, 1.36), (2.24, 1.38), (2.96, 1.38), (3.34, 1.33),
        (3.66, 1.18), (3.94, 1.04), (4.04, 1.02), (4.58, 1.01), (4.72, 0.97), (4.80, 0.88),
        (4.80, 0.34), (4.68, 0.24), (4.16, 0.19), (0.80, 0.18), (0.16, 0.22), (0.00, 0.32),
