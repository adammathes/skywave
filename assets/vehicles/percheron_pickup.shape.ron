        wheel_pos: (2.20, 1.02),
        wheel_radius: 0.21,
        column_angle_deg: 32,
        mirror_pos: (2.06, 1.70),
        seat: (2.68, 0.80),
        driver_offset: 0.44,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: dark gray plastic, gray cloth with
