// Corvid Hatch body: a mid-90s American pony car in its top trim.
//
// Intent: the decade's soft dart. A low, rounded nose with flush composite lamps either
// side of a thin slot and no grille above the bumper, a long sloping hood, a windshield laid
// almost flat, a short roof with T-top panels, then one big curved glass hatch running
// nearly to the tail with a low spoiler across its end. Smooth body-colored bumpers with
// no ground-effects kit or stripes, black trim, full-width tail lamps and five-spoke
// alloys. Front engine, rear drive. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "corvid_hatch",
    side: [
        (0.00, 0.46), (0.08, 0.57), (0.34, 0.65), (1.60, 0.84), (1.72, 0.87),
        (2.44, 1.28), (2.56, 1.31), (2.94, 1.30), (3.60, 1.12), (4.26, 1.00), (4.78, 0.98),
        (4.91, 0.88),
        (4.91, 0.32), (4.74, 0.22), (4.20, 0.18), (0.70, 0.16), (0.16, 0.19), (0.00, 0.30),
    ],
    plan: [
        (0.00, 0.62), (0.10, 0.78), (0.40, 0.89), (0.90, 0.93), (3.90, 0.94), (4.60, 0.925),
        (4.91, 0.86),
    ],
    belt: [(1.70, 0.86), (2.94, 0.92), (4.26, 0.99)],
    section: Section(shoulder: 0.90, tumblehome_deg: 24, greenhouse_frac: 0.72, crown: 0.05, tuck: 0.06),
    glass: Glass(
        windshield: (1.74, 2.44),
        backlight: (2.98, 4.24),
        side: [(1.84, 2.86), (2.92, 3.44)],
    ),
    wheels: Wheels(radius: 0.33, width: 0.245, arch_clearance: 0.05, front_x: 0.98, rear_x: 3.55, track: 1.54),
    front: Front(lights: Rect, grille: Slot, bumper: Body, bumper_y: (0.22, 0.36)),
    rear: Rear(lights: FullWidth, spoiler: Lip, bumper: Body, bumper_y: (0.30, 0.46)),
    seams: Seams(hood: true, trunk: false, doors: 2, hood_width: 0.85, creases: [(0.30, 0.56, 4.80, 0.60)]),
    parts: Parts(mirrors: Door, handles: Flush, wipers: 2, exhaust: Dual, antenna: Mast, rims: Alloy5, hubcaps: false),
    details: [TTop, BlackTrim, Badge(Bar)],
    // Bright red, black, white, bright teal, dark green metallic, bright blue, purple, silver.
    palette: ["#c0141e", "#141416", "#ecebe6", "#14868a", "#1c4a3a", "#1f4fa8", "#3e2a62", "#b9bcc0"],
    accent: "#c8c8c8",
    interior: InteriorShape(
