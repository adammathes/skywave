// Corvid Hatch body: a late-80s American pony car in its top trim.
//
// Intent: the wedge of its decade. A long, low, sharp nose with slim rectangular lamps
// either side of a slot, no grille above the bumper, a long flat hood, a windshield laid
// right back, a short roof with T-top panels, then one big curved glass hatch running
// nearly to the tail with a lip spoiler wrapped round its end. A full ground-effects kit
// (deep air dam, side skirts, rear valance), a tape stripe low along the doors, black
// trim, full-width tail lamps, and wide five-hole alloys. Front engine, rear drive.
// Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "corvid_hatch",
    side: [
        (0.00, 0.50), (0.05, 0.60), (0.30, 0.68), (1.70, 0.86), (1.80, 0.88),
        (2.42, 1.24), (2.52, 1.27), (2.96, 1.26), (3.60, 1.10), (4.22, 0.99), (4.74, 0.97),
        (4.88, 0.90),
        (4.88, 0.30), (4.70, 0.22), (4.20, 0.18), (0.70, 0.16), (0.14, 0.20), (0.00, 0.30),
    ],
    plan: [
        (0.00, 0.70), (0.12, 0.84), (0.50, 0.91), (3.90, 0.92), (4.60, 0.91), (4.88, 0.88),
    ],
    belt: [(1.78, 0.87), (2.96, 0.92), (4.22, 0.98)],
    section: Section(shoulder: 0.92, tumblehome_deg: 22, greenhouse_frac: 0.74, crown: 0.04, tuck: 0.05),
    glass: Glass(
        windshield: (1.82, 2.42),
        backlight: (3.00, 4.20),
        side: [(1.90, 2.86), (2.92, 3.40)],
    ),
    wheels: Wheels(radius: 0.33, width: 0.245, arch_clearance: 0.05, front_x: 0.98, rear_x: 3.54, track: 1.52),
    front: Front(lights: Rect, grille: Slot, bumper: Body, bumper_y: (0.22, 0.36)),
    rear: Rear(lights: FullWidth, spoiler: Lip, bumper: Body, bumper_y: (0.30, 0.46)),
    seams: Seams(hood: true, trunk: false, doors: 2, hood_width: 0.85, creases: [(0.10, 0.52, 4.80, 0.56)]),
    parts: Parts(mirrors: Door, handles: Flush, wipers: 2, exhaust: Dual, antenna: Mast, rims: Dish, hubcaps: false),
    details: [BodyKit, TTop, BlackTrim, SideStripe, Badge(Bar)],
    // Bright red, black, white, bright blue, silver, dark red.
    palette: ["#b0141c", "#141416", "#ecebe6", "#1f3f8f", "#b9bcc0", "#6b1520"],
    accent: "#c8c8c8",
    interior: InteriorShape(
        dash_height: 0.84,
        dash_x: 2.00,
        wheel_pos: (2.42, 0.72),
        wheel_radius: 0.19,
        column_angle_deg: 24,
        mirror_pos: (2.30, 1.16),
        seat: (2.90, 0.38),
        driver_offset: 0.38,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: charcoal dash and cloth buckets
        // with a gray insert, charcoal carpet, a gray headliner, red-orange dials.
        colors: ["#1c1d20", "#2a2b2e", "#26272a", "#4a4b4f", "#303134", "#e0482a"],
        display: "#ff6a3a",
        insert: "#55575c",
        piping: "#141416",
        dash_top: "#202124",
        applique: None,
        manual: false,
