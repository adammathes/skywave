        wheel_radius: 0.19,
        column_angle_deg: 22,
        mirror_pos: (2.38, 1.24),
        seat: (2.96, 0.44),
        driver_offset: 0.38,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: gray cloth buckets, a black dash
