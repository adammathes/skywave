// Tern Compact: an early-2000s front-drive compact sedan with a 1.8 L four.
//
// Intent: the first car, the student's car, the one that never breaks. Light and eager: a
// free-revving four through a four-speed automatic, quick light steering, firm-enough
// springs, mild understeer and ABS. Slower than the family sedan, nimbler than it.
//
// Layout and units: docs/VEHICLES.md and crates/vehicle/src/spec.rs.
VehicleSpec(
    id: "tern_compact",
    name: "Tern Compact",
    era: Aughts,
    year: 2003,
    class: Sedan,

    mass_kg: 1150,
    dims_m: (4.42, 1.70, 1.43),    // length, width, height
    wheelbase_m: 2.62,
    track_m: 1.48,
    cg_height_m: 0.51,
    cg_fore_aft: 0.39,

    engine: Engine(
        idle_rpm: 750,
        redline_rpm: 6800,
        torque_nm: [(1000, 125), (2500, 150), (4200, 165), (5600, 158), (6800, 136)],
    ),
    gears: [2.85, 1.55, 1.02, 0.73],
    final_drive: 4.1,
    reverse: 2.4,
    shift_ms: 340,
    auto: true,
    drive: Front,

    tires: Tires(grip_lat: 1.03, grip_long: 0.99, load_sens: 0.1, slip_peak_deg: 7.8),
    suspension: Susp(spring_n_m: 25000, damper: 2300, travel_m: 0.16, antiroll: 0.32),
    steering: Steer(max_deg: 35, speed_sens: 0.55, return_rate: 8.0),
    brakes: Brakes(max_nm: 2900, bias_front: 0.69, abs: true, handbrake_nm: 2000),
    aero: Aero(cd: 0.31, frontal_m2: 2.05, downforce_coef: 0.0),
    feel: Feel(oversteer_bias: -0.1, body_roll: 0.45, engine_sound: "i4", shift_jerk: 0.1),
    interior: Interior(
        dash: "sport_00s",
        gauges: [Speedo(0, 140, mph), Tach(0, 8000)],
        radio: "amber_seek",
    ),
    shape: "tern_compact.shape.ron",
)
