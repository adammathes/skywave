// Appaloosa Convertible body: the Appaloosa GT as a convertible, top up.
//
// Intent: the notchback's nose, flanks and tail with the roof cut off at the windshield
// header and a black fabric top raised over the cabin, with a plastic rear window; the
// door glass is down. Otherwise as the coupe: a long hood and short deck in crisp flat panels. A sloped face with four
// rectangular lamps either side of a narrow slot, a body-colored front air dam, an
// upright windshield, a squared roof with thin pillars and a near-upright rear window over
// a short flat trunk with a small lip. Wide ribbed tail lamps, a waist crease, black trim
// and simple turbine-look alloys. Front engine, rear drive. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "appaloosa_convertible",
    side: [
        (0.00, 0.60), (0.05, 0.69), (0.24, 0.76), (1.52, 0.89), (1.60, 0.90),
        (2.20, 1.30), (2.26, 0.935), (3.70, 0.975),
        (4.48, 0.98), (4.56, 0.93),
        (4.56, 0.32), (4.40, 0.24), (3.90, 0.20), (0.80, 0.19), (0.14, 0.22), (0.00, 0.30),
    ],
    plan: [
        (0.00, 0.80), (0.06, 0.845), (0.30, 0.87), (4.36, 0.875), (4.50, 0.865), (4.56, 0.85),
    ],
    belt: [(1.58, 0.89), (2.26, 0.925), (3.64, 0.965), (4.56, 0.97)],
    section: Section(shoulder: 0.95, tumblehome_deg: 18, greenhouse_frac: 0.78, crown: 0.03, tuck: 0.04),
    glass: Glass(
        windshield: (1.62, 2.20),
        // No side glass; the backlight range is where the top folds (its rear window).
        backlight: (3.72, 4.08),
        side: [],
    ),
    wheels: Wheels(radius: 0.32, width: 0.22, arch_clearance: 0.05, front_x: 0.88, rear_x: 3.43, track: 1.45),
    front: Front(lights: Quad, grille: Slot, bumper: Body, bumper_y: (0.26, 0.44)),
    rear: Rear(lights: FullWidth, spoiler: Lip, bumper: Body, bumper_y: (0.30, 0.46)),
    seams: Seams(hood: true, trunk: true, doors: 2, hood_width: 0.78, creases: [(0.10, 0.64, 4.52, 0.68)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 2, exhaust: Dual, antenna: Mast, rims: Turbine, hubcaps: false),
    details: [HoodScoop, BlackTrim, Badge(Bar)],
    roof: Roof(kind: Convertible(top: Up)),
    // The second color gets a side stripe.
    color_details: [(1, SideStripe)],
    // White, bright red, black, medium blue, silver, dark red, silver over charcoal.
    palette: ["#efeee9", "#c0161f", "#18191b", "#2b4a8a", "#b9bcc0", "#6d1a22", "#c4c7cc/#4a4e55"],
    // The top: black canvas.
    accent: "#1c1c1e",
    interior: InteriorShape(
        dash_height: 0.90,
        dash_x: 1.86,
        wheel_pos: (2.28, 0.72),
        wheel_radius: 0.18,
        column_angle_deg: 24,
        mirror_pos: (2.06, 1.20),
        seat: (2.72, 0.40),
        driver_offset: 0.37,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: charcoal dash, gray cloth with
        // lighter inserts and dark piping, charcoal carpet, a plain band, orange dials.
        colors: ["#2a2c31", "#55585f", "#2f3137", "#9a9b9e", "#3b3d43", "#d07a2a"],
        display: "#ff8c2a",
        insert: "#7a7d84",
        piping: "#2a2c31",
        dash_top: "#33353a",
        applique: None,
        manual: true,
    ),
)
