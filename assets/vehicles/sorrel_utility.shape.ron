// Sorrel Utility body: a late-90s mid-size four-door sport utility.
//
// Intent: tall and boxy but softened at every corner, the family car of the decade's end.
// A wide grille between big swept lamps, a short square hood, an upright windshield, a
// long flat roof with rails, three windows a side with a blacked-out rear pillar, an
// upright liftgate. Two-tone: gray lower cladding and bumpers under the paint (the
// crease splits it), mud flaps, five-spoke alloys on tall tires. Generic period cues only.
//
// Units are meters; x runs rearward from the nose, y up from the ground. Layout:
// docs/VEHICLES.md and crates/vehicle/src/shape/params.rs.
ShapeSpec(
    id: "sorrel_utility",
    side: [
        (0.00, 0.88), (0.04, 0.99), (0.16, 1.06), (0.60, 1.11), (1.20, 1.14), (1.30, 1.15),
        (1.80, 1.66), (1.92, 1.72), (2.20, 1.75), (4.40, 1.74), (4.60, 1.71), (4.70, 1.60),
        (4.76, 1.18), (4.78, 1.12),
        (4.78, 0.52), (4.64, 0.44), (4.10, 0.40), (0.90, 0.38), (0.14, 0.44), (0.00, 0.54),
    ],
    plan: [
        (0.00, 0.80), (0.06, 0.88), (0.24, 0.92), (0.60, 0.93), (4.50, 0.93), (4.70, 0.915),
        (4.78, 0.88),
    ],
    belt: [(1.30, 1.14), (4.20, 1.18), (4.76, 1.18)],
    section: Section(shoulder: 0.94, tumblehome_deg: 10, greenhouse_frac: 0.86, crown: 0.04, tuck: 0.04),
    glass: Glass(
        windshield: (1.32, 1.84),
        backlight: (4.62, 4.75),
        side: [(1.92, 2.84), (2.94, 3.74), (3.92, 4.52)],
    ),
    wheels: Wheels(radius: 0.37, width: 0.23, arch_clearance: 0.05, front_x: 1.00, rear_x: 3.80, track: 1.56),
    front: Front(lights: Rect, grille: Wide, bumper: Body, bumper_y: (0.40, 0.58)),
    rear: Rear(lights: Dual, spoiler: Lip, bumper: Body, bumper_y: (0.44, 0.60)),
    seams: Seams(hood: true, trunk: true, doors: 4, hood_width: 0.84, creases: [(0.10, 0.70, 4.74, 0.74)]),
    parts: Parts(mirrors: Door, handles: Pull, wipers: 3, exhaust: Single, antenna: Mast, rims: Alloy5, hubcaps: false),
    details: [BlackTrim, RoofRack, MudFlaps, Badge(Chevron)],
    // Forest green, white, black, silver, maroon, sand, dark blue; each over gray cladding.
    palette: ["#243f30/#55585c", "#eeede8/#55585c", "#18191c/#45474b", "#b8bcc0/#55585c", "#5a1a22/#55585c", "#c8b896/#5a5650", "#1e2c4a/#55585c"],
    accent: "#2a2b2e",
    interior: InteriorShape(
        dash_height: 1.06,
        dash_x: 1.66,
        wheel_pos: (2.10, 0.92),
        wheel_radius: 0.19,
        column_angle_deg: 30,
        mirror_pos: (1.98, 1.58),
        seat: (2.60, 0.66),
        driver_offset: 0.40,
        rear_seat: true,
        dials: 2,
        // Dash, seats, carpet, headliner, trim, accent: two-tone gray and tan, tan cloth
        // with a darker insert, tan carpet, amber-lit dials.
        colors: ["#3c3a36", "#a8987c", "#5e5446", "#cfc6b4", "#6e6656", "#b8a888"],
        display: "#ffb040",
