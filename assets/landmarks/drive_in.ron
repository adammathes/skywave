// A drive-in theater: a big screen at the back of a lot by the road, rows of speaker posts
// before it, a projection booth and a lit marquee pylon by the entrance. Grounded; variant
// C is its roadside-kitsch take. At night the screen glows and the rows fill with cars (the
// basin's set pieces park them: crates/world/src/procgen/setpieces.rs). Kit format:
// crates/world/src/landmarks.rs and docs/adr/0007-landmark-kits.md. Kit frame, m: x across
// the lot (to the right seen from the road), y up, z toward the road; the lot spans x
// -24..24 and z -44..0. Car rows stand between the posts, at x -12, -6, 0, 6, 12 and z
// -17, -25, -33, facing the screen.
Kit(
    id: "drive_in",
    about: "A drive-in movie theater's screen, speaker rows and marquee on its own lot.",
    tone: Grounded,
    lot: (48.0, 44.0),
    ground: Some("gravel"),
    paints: [
        ("gravel", (color: Pal(ConcreteDark), surface: Asphalt)),
        ("screen", (color: Srgb(0xE8EAEC), surface: Plain, glow: Some((Srgb(0x9DB0CC), Lamp)))),
        ("frame", (color: Pal(MetalDark), surface: Metal)),
        ("skirt", (color: Pal(Sand), surface: Stucco)),
        ("booth", (color: Pal(StuccoCream), surface: Stucco)),
        ("roof", (color: Pal(RoofGravel), surface: RoofGravel)),
        ("window", (color: Pal(WindowWarm), surface: Glass, glow: Some((Pal(WindowWarm), Window)))),
        ("post", (color: Pal(MetalLight), surface: Metal)),
        ("sign", (color: Srgb(0xF4E9D0), surface: Plain, glow: Some((Srgb(0xFFD27A), Neon)))),
        ("trim", (color: Pal(Terracotta), surface: Paint)),
    ],
    variants: [
        Variant(
            name: "Steel screen",
            about: "A plain white screen on a braced steel frame over a stucco skirt, a booth, a box marquee on two posts.",
            parts: [
                // The screen: its face toward the road, the frame and its raked braces behind,
                // a stucco skirt under it.
                Box(lo: (-15.0, 5.0, -38.2), hi: (15.0, 18.0, -38.0), paint: "screen"),
                Box(lo: (-15.6, 4.4, -39.0), hi: (15.6, 18.6, -38.2), paint: "frame"),
                Box(lo: (-15.6, 0.0, -39.4), hi: (15.6, 4.4, -38.6), paint: "skirt"),
                Strut(a: (-14.0, 0.0, -43.0), b: (-14.0, 17.0, -39.2), w: 0.35, paint: "frame"),
                Strut(a: (-7.0, 0.0, -43.0), b: (-7.0, 17.0, -39.2), w: 0.35, paint: "frame"),
                Strut(a: (0.0, 0.0, -43.0), b: (0.0, 17.0, -39.2), w: 0.35, paint: "frame"),
                Strut(a: (7.0, 0.0, -43.0), b: (7.0, 17.0, -39.2), w: 0.35, paint: "frame"),
                Strut(a: (14.0, 0.0, -43.0), b: (14.0, 17.0, -39.2), w: 0.35, paint: "frame"),
                Strut(a: (-14.0, 9.0, -41.0), b: (14.0, 9.0, -41.0), w: 0.25, paint: "frame"),
                // Speaker posts in three rows.
                Strut(a: (-15.0, 0.0, -13.5), b: (-15.0, 1.2, -13.5), w: 0.1, paint: "post"),
                Box(lo: (-15.18, 1.15, -13.6), hi: (-14.82, 1.45, -13.4), paint: "post"),
                Strut(a: (-9.0, 0.0, -13.5), b: (-9.0, 1.2, -13.5), w: 0.1, paint: "post"),
                Box(lo: (-9.18, 1.15, -13.6), hi: (-8.82, 1.45, -13.4), paint: "post"),
                Strut(a: (-3.0, 0.0, -13.5), b: (-3.0, 1.2, -13.5), w: 0.1, paint: "post"),
