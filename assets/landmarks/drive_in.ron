                Strut(a: (9.0, 0.0, -13.5), b: (9.0, 1.2, -13.5), w: 0.1, paint: "post"),
                Box(lo: (8.82, 1.15, -13.6), hi: (9.18, 1.45, -13.4), paint: "post"),
                Strut(a: (15.0, 0.0, -13.5), b: (15.0, 1.2, -13.5), w: 0.1, paint: "post"),
                Box(lo: (14.82, 1.15, -13.6), hi: (15.18, 1.45, -13.4), paint: "post"),
                Strut(a: (-15.0, 0.0, -21.5), b: (-15.0, 1.2, -21.5), w: 0.1, paint: "post"),
