        ("frame", (color: Pal(MetalDark), surface: Metal)),
        ("steel", (color: Srgb(0x8E959A), surface: Metal)),
        ("wall", (color: Pal(StuccoCream), surface: Stucco)),
        ("cap", (color: Pal(StuccoWhite), surface: Stucco)),
        ("fence", (color: Pal(Bark), surface: Wood)),
        ("post", (color: Pal(MetalLight), surface: Metal)),
        ("speaker", (color: Pal(MetalDark), surface: Metal)),
