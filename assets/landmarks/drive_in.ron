                Box(lo: (17.5, 6.05, -1.5), hi: (23.1, 6.2, -1.42), paint: "bulbs"),
                Box(lo: (17.5, 9.2, -1.5), hi: (23.1, 9.35, -1.42), paint: "bulbs"),
                Box(lo: (17.45, 6.05, -1.5), hi: (17.6, 9.35, -1.42), paint: "bulbs"),
