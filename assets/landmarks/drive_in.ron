            paints: [
                ("star", (color: Srgb(0xFFE15A), glow: Some((Srgb(0xFFC23A), Neon)))),
                ("bulbs", (color: Srgb(0xFFE7A0), glow: Some((Srgb(0xFFC860), Neon)))),
            ],
            parts: [
                // A five-pointed star of neon tube, 6 m across, over the sign.
                Strut(a: (20.3, 22.0, -2.0), b: (22.06, 16.57, -2.0), w: 0.35, paint: "star"),
                Strut(a: (22.06, 16.57, -2.0), b: (17.45, 19.93, -2.0), w: 0.35, paint: "star"),
                Strut(a: (17.45, 19.93, -2.0), b: (23.15, 19.93, -2.0), w: 0.35, paint: "star"),
                Strut(a: (23.15, 19.93, -2.0), b: (18.54, 16.57, -2.0), w: 0.35, paint: "star"),
                Strut(a: (18.54, 16.57, -2.0), b: (20.3, 22.0, -2.0), w: 0.35, paint: "star"),
                Strut(a: (20.3, 14.5, -2.0), b: (20.3, 16.8, -2.0), w: 0.2, paint: "frame"),
