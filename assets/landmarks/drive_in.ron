                Strut(a: (-9.0, 0.0, -21.5), b: (-9.0, 1.2, -21.5), w: 0.1, paint: "post"),
                Box(lo: (-9.18, 1.15, -21.6), hi: (-8.82, 1.45, -21.4), paint: "post"),
                Strut(a: (-3.0, 0.0, -21.5), b: (-3.0, 1.2, -21.5), w: 0.1, paint: "post"),
                Box(lo: (-3.18, 1.15, -21.6), hi: (-2.82, 1.45, -21.4), paint: "post"),
                Strut(a: (3.0, 0.0, -21.5), b: (3.0, 1.2, -21.5), w: 0.1, paint: "post"),
                Box(lo: (2.82, 1.15, -21.6), hi: (3.18, 1.45, -21.4), paint: "post"),
                Strut(a: (9.0, 0.0, -21.5), b: (9.0, 1.2, -21.5), w: 0.1, paint: "post"),
                Box(lo: (8.82, 1.15, -21.6), hi: (9.18, 1.45, -21.4), paint: "post"),
                Strut(a: (15.0, 0.0, -21.5), b: (15.0, 1.2, -21.5), w: 0.1, paint: "post"),
                Box(lo: (14.82, 1.15, -21.6), hi: (15.18, 1.45, -21.4), paint: "post"),
                Strut(a: (-15.0, 0.0, -29.5), b: (-15.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (-15.18, 1.15, -29.6), hi: (-14.82, 1.45, -29.4), paint: "post"),
                Strut(a: (-9.0, 0.0, -29.5), b: (-9.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (-9.18, 1.15, -29.6), hi: (-8.82, 1.45, -29.4), paint: "post"),
                Strut(a: (-3.0, 0.0, -29.5), b: (-3.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (-3.18, 1.15, -29.6), hi: (-2.82, 1.45, -29.4), paint: "post"),
                Strut(a: (3.0, 0.0, -29.5), b: (3.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (2.82, 1.15, -29.6), hi: (3.18, 1.45, -29.4), paint: "post"),
                Strut(a: (9.0, 0.0, -29.5), b: (9.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (8.82, 1.15, -29.6), hi: (9.18, 1.45, -29.4), paint: "post"),
                Strut(a: (15.0, 0.0, -29.5), b: (15.0, 1.2, -29.5), w: 0.1, paint: "post"),
                Box(lo: (14.82, 1.15, -29.6), hi: (15.18, 1.45, -29.4), paint: "post"),
                // The projection booth behind the rows, its window toward the screen.
                Box(lo: (-3.0, 0.0, -10.0), hi: (3.0, 3.2, -6.0), paint: "booth"),
                Box(lo: (-3.3, 3.2, -10.3), hi: (3.3, 3.5, -5.7), paint: "roof"),
                Box(lo: (-1.2, 1.6, -10.08), hi: (1.2, 2.6, -10.0), paint: "window"),
                // The ticket booth at the entrance.
                Box(lo: (-21.0, 0.0, -8.0), hi: (-18.6, 2.6, -5.6), paint: "booth"),
                Box(lo: (-21.3, 2.6, -8.3), hi: (-18.3, 2.85, -5.3), paint: "roof"),
                Box(lo: (-18.6, 1.0, -7.4), hi: (-18.52, 2.0, -6.2), paint: "window"),
                // The marquee: a lit box on two posts by the road.
                Strut(a: (18.6, 0.0, -2.0), b: (18.6, 6.4, -2.0), w: 0.3, paint: "frame"),
                Strut(a: (22.0, 0.0, -2.0), b: (22.0, 6.4, -2.0), w: 0.3, paint: "frame"),
                Box(lo: (17.6, 6.2, -2.5), hi: (23.0, 9.2, -1.5), paint: "sign"),
                Box(lo: (17.4, 9.2, -2.6), hi: (23.2, 9.5, -1.4), paint: "trim"),
                // Lamps at the entrance.
                Strut(a: (-23.0, 0.0, -1.0), b: (-23.0, 5.4, -1.0), w: 0.16, paint: "frame"),
                Lamp(at: (-23.0, 5.6, -1.0), color: Srgb(0xFFE2B0), radius: 18.0),
                Strut(a: (16.0, 0.0, -1.0), b: (16.0, 5.4, -1.0), w: 0.16, paint: "frame"),
                Lamp(at: (16.0, 5.6, -1.0), color: Srgb(0xFFE2B0), radius: 18.0),
