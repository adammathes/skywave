        ),
        Variant(
            name: "Stucco tower",
            about: "A's screen framed in a stepped peach stucco tower with a neon crown line, a taller marquee.",
            from: Some('A'),
            paints: [
                ("tower", (color: Pal(Peach), surface: Stucco)),
                ("crown", (color: Pal(NeonCyan), glow: Some((Pal(NeonCyan), Neon)))),
            ],
            parts: [
                // Stepped wings either side of the screen and a parapet over it.
                Box(lo: (-18.0, 0.0, -40.0), hi: (-15.6, 20.0, -38.0), paint: "tower"),
                Box(lo: (15.6, 0.0, -40.0), hi: (18.0, 20.0, -38.0), paint: "tower"),
                Box(lo: (-20.0, 0.0, -39.6), hi: (-18.0, 15.0, -38.4), paint: "tower"),
                Box(lo: (18.0, 0.0, -39.6), hi: (20.0, 15.0, -38.4), paint: "tower"),
                Box(lo: (-15.6, 18.6, -40.0), hi: (15.6, 20.0, -38.0), paint: "tower"),
                Box(lo: (-18.0, 20.0, -38.6), hi: (18.0, 20.4, -38.0), paint: "crown"),
