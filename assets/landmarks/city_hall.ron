// A city hall: the civic building at the head of the main boulevard, where the boulevard
// meets the road along the foot of the hills, so you see it the whole way up. Grounded;
// lettered CITY HALL, never a name. Kit format: crates/world/src/landmarks.rs and
// docs/adr/0007-landmark-kits.md. Kit frame, m: x across the lot (to the right seen from the
// road), y up, z toward the road; the lot spans x -30..30 and z -48..0, a forecourt in front.
Kit(
    id: "city_hall",
    about: "A city hall at the head of the boulevard.",
    tone: Grounded,
    lot: (60.0, 48.0),
    ground: Some("pad"),
    paints: [
        ("pad", (color: Pal(Concrete), surface: Concrete)),
        ("stone", (color: Srgb(0xDCD4C2), surface: Concrete)),
        ("ledge", (color: Srgb(0xC4BBA6), surface: Concrete)),
        ("glass", (color: Pal(Glass), surface: Glass, glow: Some((Srgb(0xFFD9A0), Window)))),
        ("lawn", (color: Pal(Lawn), surface: Lawn)),
        ("bronze", (color: Srgb(0x6A5432), surface: Metal)),
        ("pole", (color: Pal(MetalDark), surface: Metal)),
        ("banner", (color: Pal(Navy), surface: Paint)),
    ],
    variants: [
        Variant(
            name: "Domed",
            about: "Limestone wings either side of a columned portico, a drum and a green copper dome with a lantern rising behind it.",
