// A coffee shop of the jet age: a glass box under a roof that swoops up toward the road,
// a stone kitchen block behind, a tall pole sign by the street. Grounded: every valley had a
// few. Kit format: crates/world/src/landmarks.rs and docs/adr/0007-landmark-kits.md. Kit
// frame, m: x across the lot (to the right seen from the road), y up, z toward the road; the
// lot spans x -20..20 and z -36..0, parking under and in front of the roof's overhang.
Kit(
    id: "coffee_shop",
    about: "A jet-age coffee shop: a glass dining room under a swooping roof and a tall pole sign.",
    tone: Grounded,
    lot: (40.0, 36.0),
    ground: Some("pad"),
    paints: [
        ("pad", (color: Pal(Asphalt), surface: Asphalt)),
        ("stripe", (color: Pal(PaintWhite), surface: Paint)),
        ("wall", (color: Pal(StuccoCream), surface: Stucco)),
        ("stone", (color: Shade(Sand, 200), surface: Brick)),
        ("glass", (color: Pal(Glass), surface: Glass, glow: Some((Pal(WindowWarm), Window)))),
        ("mullion", (color: Pal(MetalLight), surface: Metal)),
        ("counter", (color: Pal(Teal), surface: Paint)),
        ("roof", (color: Srgb(0xF2EEE4), surface: Paint)),
        ("edge", (color: Srgb(0xE2672F), surface: Paint)),
        ("neon", (color: Srgb(0xFFB27A), glow: Some((Srgb(0xFF8A3A), Neon)))),
        ("pole", (color: Pal(MetalDark), surface: Metal)),
        ("sign", (color: Srgb(0xF4ECDA), glow: Some((Srgb(0xFFF1D6), Neon)))),
        ("star", (color: Srgb(0xFFF4C2), glow: Some((Srgb(0xFFE07A), Neon)))),
    ],
    variants: [
