                Box(lo: (8.3, 0.06, -23.05), hi: (11.85, 0.08, -22.75), paint: "stripe"),
                Box(lo: (12.0, 0.06, -24.0), hi: (12.14, 0.08, -22.5), paint: "stripe"),
                Box(lo: (12.0, 0.06, -21.0), hi: (12.14, 0.08, -19.5), paint: "stripe"),
                Box(lo: (12.0, 0.06, -18.0), hi: (12.14, 0.08, -16.5), paint: "stripe"),
