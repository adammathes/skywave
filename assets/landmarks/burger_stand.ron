                Panel(a: (10.0, 0.07, -6.5), b: (9.2, 0.07, -5.6), c: (10.0, 0.07, -6.05), t: 0.02, paint: "stripe"),
                Box(lo: (-1.4, 0.06, -29.15), hi: (1.0, 0.08, -28.85), paint: "stripe"),
