                Panel(a: (-13.0, 8.5, -27.5), b: (-14.71, 7.4, -26.68), c: (-13.13, 8.55, -27.77), t: 0.04, paint: "frond"),
                Panel(a: (-13.0, 8.5, -27.5), b: (-14.71, 7.4, -28.32), c: (-12.87, 8.55, -27.77), t: 0.04, paint: "frond"),
                Panel(a: (-13.0, 8.5, -27.5), b: (-13.42, 7.4, -29.35), c: (-12.71, 8.55, -27.57), t: 0.04, paint: "frond"),
                Panel(a: (-13.0, 8.5, -27.5), b: (-11.82, 7.4, -28.99), c: (-12.77, 8.55, -27.31), t: 0.04, paint: "frond"),
                Cylinder(at: (13.0, 0.0, -27.5), r: 0.26, h: 8.5, sides: 8, paint: "trunk"),
                Panel(a: (13.0, 8.5, -27.5), b: (14.57, 7.4, -26.43), c: (12.83, 8.55, -27.25), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (13.14, 7.4, -25.61), c: (12.7, 8.55, -27.48), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (11.61, 7.4, -26.21), c: (12.8, 8.55, -27.72), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (11.12, 7.4, -27.79), c: (13.05, 8.55, -27.8), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (12.05, 7.4, -29.15), c: (13.26, 8.55, -27.65), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (13.7, 7.4, -29.27), c: (13.28, 8.55, -27.39), t: 0.04, paint: "frond"),
                Panel(a: (13.0, 8.5, -27.5), b: (14.82, 7.4, -28.06), c: (13.09, 8.55, -27.21), t: 0.04, paint: "frond"),
                // Stalls in front, the drive-thru lane's dashed line down the right side and its stop
