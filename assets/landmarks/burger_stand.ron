// A walk-up burger stand of a chain, red, white and yellow, with a giant burger on the roof and
// palms at the back: roadside kitsch, built to be seen from the boulevard. A drive-thru window on
// its right side, the lane marked past it and round the back to the street again, as the donut
// shop's. Kit format: crates/world/src/landmarks.rs and docs/adr/0007-landmark-kits.md. Kit
// frame, m: x across the lot (to the right seen from the road), y up, z toward the road; the lot
// spans x -15..15 and z -32..0, parking in front of the stand.
Kit(
    id: "burger_stand",
    about: "A chain's burger stand with a giant burger on its roof and a drive-thru window.",
    tone: Kitsch,
    lot: (30.0, 32.0),
    ground: Some("pad"),
    paints: [
        ("pad", (color: Pal(Asphalt), surface: Asphalt)),
        ("stripe", (color: Pal(PaintWhite), surface: Paint)),
        ("curb", (color: Pal(Concrete), surface: Concrete)),
        ("wall", (color: Pal(StuccoWhite), surface: Stucco)),
        ("trim", (color: Pal(MetalLight), surface: Metal)),
        ("glass", (color: Pal(Glass), surface: Glass, glow: Some((Pal(WindowWarm), Window)))),
        ("red", (color: Srgb(0xD22B2B), surface: Paint)),
        ("yellow", (color: Srgb(0xF6C33A), surface: Paint)),
        ("neon", (color: Srgb(0xFFF2D8), glow: Some((Srgb(0xFFE6B0), Neon)))),
        ("pole", (color: Pal(MetalDark), surface: Metal)),
        ("bun", (color: Srgb(0xD8964A), surface: Paint, glow: Some((Srgb(0x7A4A22), Window)))),
        ("seed", (color: Srgb(0xF6EBCF), surface: Paint)),
        ("patty", (color: Srgb(0x5A3220), surface: Paint)),
        ("cheese", (color: Srgb(0xF7C531), surface: Paint)),
        ("lettuce", (color: Srgb(0x6DB83A), surface: Paint)),
        ("tomato", (color: Srgb(0xD8402E), surface: Paint)),
        ("trunk", (color: Srgb(0x8A6A48), surface: Paint)),
        ("frond", (color: Srgb(0x4E8A3A), surface: Paint)),
    ],
    variants: [
        Variant(
            name: "Burger on the roof",
            about: "A white stand with a red band and a yellow pinstripe, BURGERS in lights on the band, a burger 6 m across on its roof, a pole sign by the street and two palms behind.",
            parts: [
                // The stand: a white box, the red band round its top with a yellow pinstripe under
                // it, a glass front between mullions.
                Box(lo: (-8.0, 0.0, -26.0), hi: (8.0, 4.0, -15.0), paint: "wall"),
                Box(lo: (-8.3, 3.0, -26.3), hi: (8.3, 4.4, -14.7), paint: "red"),
                Box(lo: (-8.32, 2.82, -26.32), hi: (8.32, 2.94, -14.68), paint: "yellow"),
                Box(lo: (-7.0, 0.45, -15.0), hi: (7.0, 2.7, -14.85), paint: "glass"),
                Box(lo: (-8.0, 0.0, -15.0), hi: (8.0, 0.45, -14.8), paint: "trim"),
                Strut(a: (-3.5, 0.45, -14.9), b: (-3.5, 2.7, -14.9), w: 0.14, paint: "trim"),
                Strut(a: (0.0, 0.45, -14.9), b: (0.0, 2.7, -14.9), w: 0.14, paint: "trim"),
                Strut(a: (3.5, 0.45, -14.9), b: (3.5, 2.7, -14.9), w: 0.14, paint: "trim"),
                Letters(at: (0.0, 3.7, -14.7), text: "BURGERS", size: 0.8, finish: Neon, paint: "neon"),
                // The drive-thru window and its red canopy on the right side.
                Box(lo: (8.0, 1.0, -21.0), hi: (8.12, 2.2, -19.0), paint: "glass"),
                Box(lo: (8.0, 2.6, -21.6), hi: (9.6, 2.8, -18.4), paint: "red"),
                Window(at: (8.12, 1.0, -20.0), face: Right),
                // The burger: bun, patty, a slice of cheese with its corners out, lettuce, tomato,
