                Box(lo: (-7.56, 0.06, -13.5), hi: (-7.44, 0.08, -8.0), paint: "stripe"),
                Box(lo: (-4.56, 0.06, -13.5), hi: (-4.44, 0.08, -8.0), paint: "stripe"),
                Box(lo: (-1.56, 0.06, -13.5), hi: (-1.44, 0.08, -8.0), paint: "stripe"),
