                Lathe(at: (0.0, 7.09, -20.5), profile: [(3.1, 0.0), (3.15, 0.4), (3.0, 0.9), (2.6, 1.5), (1.9, 2.0), (1.0, 2.3), (0.0, 2.4)], sides: 28, paint: "bun"),
                Box(lo: (-1.74, 8.45, -18.44), hi: (-1.46, 8.55, -18.34), paint: "seed"),
                Box(lo: (-0.64, 9.05, -18.76), hi: (-0.36, 9.15, -18.66), paint: "seed"),
                Box(lo: (0.56, 8.75, -18.36), hi: (0.84, 8.85, -18.26), paint: "seed"),
                Box(lo: (1.56, 8.25, -18.34), hi: (1.84, 8.35, -18.24), paint: "seed"),
                Box(lo: (-0.04, 7.95, -17.57), hi: (0.24, 8.05, -17.47), paint: "seed"),
                Box(lo: (-1.14, 7.75, -17.67), hi: (-0.86, 7.85, -17.57), paint: "seed"),
                Box(lo: (1.06, 7.55, -17.68), hi: (1.34, 7.65, -17.58), paint: "seed"),
                // The pole sign by the street, over the lane out: BURGERS and DRIVE THRU, a lamp on top.
                Strut(a: (-14.4, 0.0, -4.0), b: (-14.4, 7.2, -4.0), w: 0.22, paint: "pole"),
                Box(lo: (-14.9, 5.4, -4.25), hi: (-10.9, 6.8, -3.75), paint: "red"),
                Box(lo: (-14.9, 4.5, -4.2), hi: (-11.9, 5.3, -3.8), paint: "yellow"),
                Letters(at: (-12.9, 6.1, -3.72), text: "BURGERS", size: 0.6, finish: Painted, paint: "seed"),
                Letters(at: (-13.4, 4.9, -3.77), text: "DRIVE THRU", size: 0.32, finish: Painted, paint: "red"),
                Lamp(at: (-14.4, 7.4, -4.0), color: Srgb(0xFFE2B0), radius: 20.0),
                // Lamps on the roof's front corners.
                Lamp(at: (-6.0, 4.8, -15.2), color: Srgb(0xFFE2B0), radius: 10.0),
                Lamp(at: (6.0, 4.8, -15.2), color: Srgb(0xFFE2B0), radius: 10.0),
                // Two palms behind, clear of the lane round the back.
                Cylinder(at: (-13.0, 0.0, -27.5), r: 0.26, h: 8.5, sides: 8, paint: "trunk"),
                Panel(a: (-13.0, 8.5, -27.5), b: (-11.1, 7.4, -27.5), c: (-13.0, 8.55, -27.2), t: 0.04, paint: "frond"),
                Panel(a: (-13.0, 8.5, -27.5), b: (-11.82, 7.4, -26.01), c: (-13.23, 8.55, -27.31), t: 0.04, paint: "frond"),
