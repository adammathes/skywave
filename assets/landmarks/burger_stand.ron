                Box(lo: (-0.9, 4.4, -21.4), hi: (0.9, 4.8, -19.6), paint: "trim"),
                Cylinder(at: (0.0, 4.8, -20.5), r: 3.0, h: 0.9, sides: 28, paint: "bun"),
                Cylinder(at: (0.0, 5.7, -20.5), r: 3.25, h: 0.8, sides: 28, paint: "patty"),
                Box(lo: (-2.6, 6.5, -23.1), hi: (2.6, 6.62, -17.9), paint: "cheese"),
