// A water tower: the town's tank held up where everybody can see it. Grounded; variant C
// is its roadside-kitsch take. Kit format: crates/world/src/landmarks.rs and
// docs/adr/0007-landmark-kits.md. Kit frame, m: x across the lot (to the right seen from
// the road), y up, z toward the road; the lot spans x -12..12 and z -24..0 and the tower
// stands on its middle (z -12).
Kit(
    id: "water_tower",
    about: "A municipal water tower on its own lot.",
    tone: Grounded,
    lot: (24.0, 24.0),
    ground: Some("pad"),
    paints: [
        ("pad", (color: Pal(ConcreteDark), surface: Concrete)),
        ("footing", (color: Pal(Concrete), surface: Concrete)),
        ("steel", (color: Srgb(0x8E959A), surface: Metal)),
        ("pole", (color: Pal(MetalDark), surface: Metal)),
        ("tank", (color: Srgb(0xC9CED2), surface: Metal)),
        ("roof", (color: Srgb(0xB7BDC2), surface: Metal)),
        ("door", (color: Pal(MetalDark), surface: Metal)),
    ],
    variants: [
        Variant(
            name: "Riveted, four legs",
            about: "The classic: a steel tank with a cone roof on four raked, braced legs, a balcony round it.",
            parts: [
                // Four raked legs on concrete footings, the riser pipe up the middle.
                Strut(a: (-5.0, 0.0, -17.0), b: (-3.4, 22.1, -15.4), w: 0.5, paint: "steel"),
                Strut(a: (5.0, 0.0, -17.0), b: (3.4, 22.1, -15.4), w: 0.5, paint: "steel"),
                Strut(a: (5.0, 0.0, -7.0), b: (3.4, 22.1, -8.6), w: 0.5, paint: "steel"),
                Strut(a: (-5.0, 0.0, -7.0), b: (-3.4, 22.1, -8.6), w: 0.5, paint: "steel"),
                Box(lo: (-5.7, -0.2, -17.7), hi: (-4.3, 0.45, -16.3), paint: "footing"),
                Box(lo: (4.3, -0.2, -17.7), hi: (5.7, 0.45, -16.3), paint: "footing"),
                Box(lo: (4.3, -0.2, -7.7), hi: (5.7, 0.45, -6.3), paint: "footing"),
                Box(lo: (-5.7, -0.2, -7.7), hi: (-4.3, 0.45, -6.3), paint: "footing"),
                Cylinder(at: (0.0, 0.0, -12.0), r: 0.55, h: 22.0, sides: 10, paint: "steel"),
                // Sway bracing: a ring of girts at two heights, crossed rods in each bay.
                Strut(a: (-4.45, 7.5, -16.45), b: (4.45, 7.5, -16.45), w: 0.25, paint: "steel"),
                Strut(a: (4.45, 7.5, -16.45), b: (4.45, 7.5, -7.55), w: 0.25, paint: "steel"),
                Strut(a: (4.45, 7.5, -7.55), b: (-4.45, 7.5, -7.55), w: 0.25, paint: "steel"),
                Strut(a: (-4.45, 7.5, -7.55), b: (-4.45, 7.5, -16.45), w: 0.25, paint: "steel"),
                Strut(a: (-3.91, 15.0, -15.91), b: (3.91, 15.0, -15.91), w: 0.25, paint: "steel"),
                Strut(a: (3.91, 15.0, -15.91), b: (3.91, 15.0, -8.09), w: 0.25, paint: "steel"),
                Strut(a: (3.91, 15.0, -8.09), b: (-3.91, 15.0, -8.09), w: 0.25, paint: "steel"),
                Strut(a: (-3.91, 15.0, -8.09), b: (-3.91, 15.0, -15.91), w: 0.25, paint: "steel"),
                Strut(a: (-4.93, 1.0, -16.93), b: (4.45, 7.5, -16.45), w: 0.1, paint: "steel"),
                Strut(a: (4.93, 1.0, -16.93), b: (-4.45, 7.5, -16.45), w: 0.1, paint: "steel"),
                Strut(a: (4.93, 1.0, -16.93), b: (4.45, 7.5, -7.55), w: 0.1, paint: "steel"),
                Strut(a: (4.93, 1.0, -7.07), b: (4.45, 7.5, -16.45), w: 0.1, paint: "steel"),
                Strut(a: (4.93, 1.0, -7.07), b: (-4.45, 7.5, -7.55), w: 0.1, paint: "steel"),
                Strut(a: (-4.93, 1.0, -7.07), b: (4.45, 7.5, -7.55), w: 0.1, paint: "steel"),
                Strut(a: (-4.93, 1.0, -7.07), b: (-4.45, 7.5, -16.45), w: 0.1, paint: "steel"),
                Strut(a: (-4.93, 1.0, -16.93), b: (-4.45, 7.5, -7.55), w: 0.1, paint: "steel"),
                Strut(a: (-4.45, 7.5, -16.45), b: (3.91, 15.0, -15.91), w: 0.1, paint: "steel"),
                Strut(a: (4.45, 7.5, -16.45), b: (-3.91, 15.0, -15.91), w: 0.1, paint: "steel"),
                Strut(a: (4.45, 7.5, -16.45), b: (3.91, 15.0, -8.09), w: 0.1, paint: "steel"),
                Strut(a: (4.45, 7.5, -7.55), b: (3.91, 15.0, -15.91), w: 0.1, paint: "steel"),
                Strut(a: (4.45, 7.5, -7.55), b: (-3.91, 15.0, -8.09), w: 0.1, paint: "steel"),
                Strut(a: (-4.45, 7.5, -7.55), b: (3.91, 15.0, -8.09), w: 0.1, paint: "steel"),
                Strut(a: (-4.45, 7.5, -7.55), b: (-3.91, 15.0, -15.91), w: 0.1, paint: "steel"),
                Strut(a: (-4.45, 7.5, -16.45), b: (-3.91, 15.0, -8.09), w: 0.1, paint: "steel"),
                Strut(a: (-3.91, 15.0, -15.91), b: (3.41, 21.8, -15.41), w: 0.1, paint: "steel"),
                Strut(a: (3.91, 15.0, -15.91), b: (-3.41, 21.8, -15.41), w: 0.1, paint: "steel"),
                Strut(a: (3.91, 15.0, -15.91), b: (3.41, 21.8, -8.59), w: 0.1, paint: "steel"),
                Strut(a: (3.91, 15.0, -8.09), b: (3.41, 21.8, -15.41), w: 0.1, paint: "steel"),
                Strut(a: (3.91, 15.0, -8.09), b: (-3.41, 21.8, -8.59), w: 0.1, paint: "steel"),
                Strut(a: (-3.91, 15.0, -8.09), b: (3.41, 21.8, -8.59), w: 0.1, paint: "steel"),
                Strut(a: (-3.91, 15.0, -8.09), b: (-3.41, 21.8, -15.41), w: 0.1, paint: "steel"),
                Strut(a: (-3.91, 15.0, -15.91), b: (-3.41, 21.8, -8.59), w: 0.1, paint: "steel"),
                // The balcony round the tank's foot and its rail.
                Cylinder(at: (0.0, 21.85, -12.0), r: 6.2, h: 0.15, sides: 24, paint: "steel"),
                Strut(a: (5.64, 22.0, -9.67), b: (5.64, 23.07, -9.67), w: 0.07, paint: "steel"),
                Strut(a: (2.33, 22.0, -6.36), b: (2.33, 23.07, -6.36), w: 0.07, paint: "steel"),
                Strut(a: (-2.33, 22.0, -6.36), b: (-2.33, 23.07, -6.36), w: 0.07, paint: "steel"),
                Strut(a: (-5.64, 22.0, -9.67), b: (-5.64, 23.07, -9.67), w: 0.07, paint: "steel"),
                Strut(a: (-5.64, 22.0, -14.33), b: (-5.64, 23.07, -14.33), w: 0.07, paint: "steel"),
                Strut(a: (-2.33, 22.0, -17.64), b: (-2.33, 23.07, -17.64), w: 0.07, paint: "steel"),
                Strut(a: (2.33, 22.0, -17.64), b: (2.33, 23.07, -17.64), w: 0.07, paint: "steel"),
                Strut(a: (5.64, 22.0, -14.33), b: (5.64, 23.07, -14.33), w: 0.07, paint: "steel"),
                Cylinder(at: (0.0, 22.5, -12.0), r: 6.12, h: 0.05, sides: 24, open: true, paint: "steel"),
                Cylinder(at: (0.0, 23.0, -12.0), r: 6.12, h: 0.07, sides: 24, open: true, paint: "steel"),
                // The tank: a dished bottom, a straight wall, a cone roof with an eave, a finial.
                Lathe(
                    at: (0.0, 22.0, -12.0),
                    profile: [(0.0, 0.0), (2.6, 0.3), (4.5, 0.9), (5.5, 1.9), (5.8, 2.8), (5.8, 8.0)],
                    sides: 24,
                    open: true,
                    paint: "tank",
                ),
                Lathe(
                    at: (0.0, 30.0, -12.0),
                    profile: [(6.0, 0.0), (6.0, 0.15), (4.2, 1.2), (1.2, 2.6), (0.35, 2.85), (0.0, 2.9)],
                    sides: 24,
                    paint: "roof",
                ),
                Cylinder(at: (0.0, 32.8, -12.0), r: 0.12, h: 1.4, sides: 6, paint: "steel"),
                // An obstruction beacon on the finial; a flood lamp on a pole lights the legs.
                Lamp(at: (0.0, 34.4, -12.0), color: Srgb(0xFF3A22), radius: 4.0),
                Strut(a: (-9.0, 0.0, -3.0), b: (-9.0, 3.6, -3.0), w: 0.16, paint: "pole"),
                Lamp(at: (-9.0, 3.8, -3.0), color: Srgb(0xFFE2B0), radius: 22.0),
            ],
        ),
        Variant(
            name: "Pedestal",
            about: "A later single-column tower: the column flares into a broad sky-blue bowl.",
            paints: [
                ("tank", (color: Pal(SkyBlue), surface: Metal)),
            ],
            parts: [
                // A footing, then one turned profile: the flared column, the bell under the bowl,
                // the bowl, its shoulder and crown.
                Cylinder(at: (0.0, 0.0, -12.0), r: 3.4, h: 0.5, sides: 28, paint: "footing"),
                Lathe(
                    at: (0.0, 0.5, -12.0),
                    profile: [
                        (2.4, 0.0), (1.6, 1.0), (1.4, 15.5), (1.8, 18.5), (3.4, 20.6), (5.8, 22.2),
                        (7.3, 24.2), (7.7, 26.0), (7.3, 28.0), (5.6, 29.8), (2.8, 31.0), (0.6, 31.4),
                        (0.0, 31.45),
                    ],
                    sides: 28,
                    paint: "tank",
                ),
                // A door at the column's foot, toward the road.
                Box(lo: (-0.55, 0.5, -10.72), hi: (0.55, 2.7, -10.45), paint: "door"),
                Cylinder(at: (0.0, 31.9, -12.0), r: 0.1, h: 1.3, sides: 6, paint: "steel"),
                Lamp(at: (0.0, 33.4, -12.0), color: Srgb(0xFF3A22), radius: 4.0),
                Strut(a: (-9.0, 0.0, -3.0), b: (-9.0, 3.6, -3.0), w: 0.16, paint: "pole"),
                Lamp(at: (-9.0, 3.8, -3.0), color: Srgb(0xFFE2B0), radius: 22.0),
            ],
        ),
        Variant(
            name: "Candy-striped",
            about: "A's tower painted red with a white roof and hoops, marquee bulbs under the balcony: roadside kitsch.",
            from: Some('A'),
            paints: [
                ("tank", (color: Srgb(0xC23B2E), surface: Paint)),
                ("roof", (color: Srgb(0xF1ECE2), surface: Paint)),
                ("hoop", (color: Srgb(0xF1ECE2), surface: Paint)),
                ("marquee", (color: Srgb(0xFFE7A0), glow: Some((Srgb(0xFFC860), Neon)))),
            ],
            parts: [
                // Two white hoops round the wall, a ring of marquee bulbs under the balcony.
                Cylinder(at: (0.0, 25.3, -12.0), r: 5.84, h: 1.0, sides: 24, open: true, paint: "hoop"),
                Cylinder(at: (0.0, 27.6, -12.0), r: 5.84, h: 1.0, sides: 24, open: true, paint: "hoop"),
                Cylinder(at: (0.0, 21.6, -12.0), r: 6.24, h: 0.22, sides: 24, open: true, paint: "marquee"),
            ],
        ),
    ],
)
