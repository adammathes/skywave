// Hillside letters: the valley's name stood up on the slope above it, white so the whole
// basin can read it. Grounded; variant C is its roadside-kitsch take. Kit format:
// crates/world/src/landmarks.rs and docs/adr/0007-landmark-kits.md. Kit frame, m: x across
// the lot (to the right seen from below), y up, z toward the valley; the lot spans x -27..27
// and z -16..0, its front along the slope's contour, and the letters' faces stand 8 m back.
// The legs run back and down into the rising ground behind.
Kit(
    id: "hillside_letters",
    about: "The valley's name in giant letters on the hillside above it.",
    tone: Grounded,
    lot: (54.0, 16.0),
    paints: [
        ("letter", (color: Srgb(0xF2F0EA), surface: Paint)),
        ("frame", (color: Pal(MetalDark), surface: Metal)),
        ("housing", (color: Pal(MetalDark), surface: Metal)),
    ],
    variants: [
        Variant(
            name: "Sheet-metal name",
            about: "MIRAGE in ten-metre white sheet-metal letters on raked legs, three flood lamps at their foot.",
            parts: [
                // MIRAGE, 46.8 m across: strokes 1.4 m wide, 1.2 m deep.
                Box(lo: (-23.4, -1.0, -9.2), hi: (-22.0, 10.0, -8.0), paint: "letter"),
                Box(lo: (-17.4, -1.0, -9.2), hi: (-16.0, 10.0, -8.0), paint: "letter"),
                Box(lo: (-13.6, -1.0, -9.2), hi: (-12.2, 10.0, -8.0), paint: "letter"),
