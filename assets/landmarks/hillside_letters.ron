                Box(lo: (0.78, 2.8, -9.2), hi: (4.62, 4.2, -8.0), paint: "letter"),
                Box(lo: (8.8, 0.0, -9.2), hi: (10.2, 10.0, -8.0), paint: "letter"),
                Box(lo: (10.2, 8.6, -9.2), hi: (15.4, 10.0, -8.0), paint: "letter"),
