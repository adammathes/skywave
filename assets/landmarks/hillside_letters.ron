                Box(lo: (-22.85, 0.2, -8.0), hi: (-22.55, 9.8, -7.85), paint: "bulbs"),
                Box(lo: (-16.85, 0.2, -8.0), hi: (-16.55, 9.8, -7.85), paint: "bulbs"),
