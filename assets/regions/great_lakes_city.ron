// Great Lakes city of the 1980s (docs/SCENARIOS.md, "Lake City"): the zone rules that dress the
// authored `lake_city` layout (assets/layouts/lake_city.ron, docs/LAYOUTS.md). The
// layout says where the lake, the river, the districts and the main roads are; these
// rules say what a district of each zone looks like. Built to work, warm
// inside: brick three-flats and bungalows, two-storey brick storefronts on the arterials, a
// dense downtown of towers. Its hero landmark is a drive-in hot dog stand on the arterial lot
// nearest the layout's `hero` point (`roadside`).
RegionTemplate(
    name: "great_lakes_city",
    driving_side: Right,
    sign_language: EnUs,
    era: EraDefaults(year: 1986, street_lights: Sodium, palette: "brick_and_limestone"),

    roadside: [RoadsideKit(kit: "hot_dog_stand", variant: 'A')],
    // A grid city: a side street that stops short of a river, the expressway or a park is
    // cut back to its last crossing rather than left dead-ended.
    through_streets: true,

    zones: Zones(
        downtown: ZoneRule(
            block_m: ((100, 130), (60, 90)),
            streets: Grid,
            alleys: true,
            styles: [Tower, Deco, Brick, Brutalist],
            trees: [(Honeylocust, 0.6), (Linden, 0.4)],
            props: Props(
                street_light_m: 30, street_tree_m: 12, hydrant_m: 70, power_pole_m: 0,
                bench_per_km: 10, billboard_per_km: 1, neon: 0.2, parked_cars: (0.5, 0.8),
            ),
            lots: Lots(width_m: (20, 36), depth_m: 40, setback_m: (0, 0, 3)),
            massing: Some(Massing(coverage: 0.65, floors: (3, 30), floors_mean: 6, floors_spread: 0.6, style_weights: [4, 2, 2, 1])),
        ),
        strip: ZoneRule(
            block_m: ((100, 160), (60, 90)),
            streets: Grid,
            alleys: true,
            styles: [Brick, Deco, Tower],
            trees: [(Linden, 0.5), (Honeylocust, 0.5)],
            props: Props(
                street_light_m: 32, street_tree_m: 14, hydrant_m: 80, power_pole_m: 0,
                bench_per_km: 8, billboard_per_km: 1, neon: 0.3, parked_cars: (0.4, 0.7),
            ),
            lots: Lots(width_m: (24, 44), depth_m: 40, setback_m: (1, 0, 4)),
            massing: Some(Massing(coverage: 0.7, floors: (1, 3), floors_mean: 1.8, floors_spread: 0.3, style_weights: [6, 2, 0.3])),
        ),
        residential: ZoneRule(
            block_m: ((180, 200), (90, 110)),
            streets: Grid,
            alleys: false,
            styles: [ThreeFlat, Bungalow, Brick],
            trees: [(Elm, 0.4), (Maple, 0.3), (Ash, 0.2), (Linden, 0.1)],
            props: Props(
                street_light_m: 45, street_tree_m: 10, hydrant_m: 100, power_pole_m: 40,
                bench_per_km: 0.5, billboard_per_km: 0, neon: 0, parked_cars: (0.4, 0.7),
            ),
            lots: Lots(width_m: (30, 40), depth_m: 40, setback_m: (6, 1.5, 6)),
            massing: Some(Massing(coverage: 0.3, floors: (1, 3), floors_mean: 1.6, floors_spread: 0.35, style_weights: [3, 4, 1])),
        ),
        suburb: ZoneRule(
            block_m: ((180, 200), (100, 120)),
            streets: Grid,
            alleys: false,
            styles: [Bungalow, Ranch, Brick],
            trees: [(Elm, 0.3), (Maple, 0.4), (Oak, 0.3)],
            props: Props(
                street_light_m: 55, street_tree_m: 12, hydrant_m: 120, power_pole_m: 45,
                bench_per_km: 0, billboard_per_km: 0, neon: 0, parked_cars: (0.2, 0.4),
            ),
            lots: Lots(width_m: (32, 44), depth_m: 40, setback_m: (8, 2, 8)),
            massing: Some(Massing(coverage: 0.25, floors: (1, 2), floors_mean: 1.2, floors_spread: 0.3, style_weights: [3, 3, 1])),
        ),
        industrial: ZoneRule(
            block_m: ((200, 300), (150, 220)),
            streets: Grid,
            alleys: false,
            styles: [Warehouse, Brick],
            trees: [(Ash, 1.0)],
            props: Props(
                street_light_m: 45, street_tree_m: 0, hydrant_m: 120, power_pole_m: 40,
                bench_per_km: 0, billboard_per_km: 3, neon: 0, parked_cars: (0.1, 0.3),
            ),
            lots: Lots(width_m: (60, 120), depth_m: 60, setback_m: (6, 4, 6)),
            massing: Some(Massing(coverage: 0.5, floors: (1, 4), floors_mean: 1.6, floors_spread: 0.4, style_weights: [3, 2])),
        ),
        commercial: ZoneRule(
            block_m: ((120, 200), (60, 90)),
            streets: Grid,
            alleys: true,
            styles: [Brick, StripMall, Deco],
            trees: [(Honeylocust, 0.5), (Linden, 0.5)],
            props: Props(
                street_light_m: 35, street_tree_m: 16, hydrant_m: 90, power_pole_m: 0,
                bench_per_km: 4, billboard_per_km: 2, neon: 0.3, parked_cars: (0.4, 0.7),
            ),
            lots: Lots(width_m: (30, 48), depth_m: 40, setback_m: (3, 0, 4)),
            massing: Some(Massing(coverage: 0.6, floors: (1, 3), floors_mean: 1.8, floors_spread: 0.35, style_weights: [5, 1, 2])),
        ),
        park: ZoneRule(
            block_m: ((150, 300), (120, 250)),
            streets: Grid,
            alleys: false,
            styles: [],
            trees: [(Elm, 0.3), (Oak, 0.3), (Maple, 0.2), (Linden, 0.2)],
            props: Props(
                street_light_m: 40, street_tree_m: 12, hydrant_m: 0, power_pole_m: 0,
                bench_per_km: 20, billboard_per_km: 0, neon: 0, parked_cars: (0.0, 0.2),
            ),
            lots: Lots(width_m: (40, 80), depth_m: 40, setback_m: (0, 0, 0)),
        ),
        beach: ZoneRule(
            block_m: ((200, 400), (40, 80)),
            streets: Beachfront,
            alleys: false,
            styles: [Brick],
            trees: [(Honeylocust, 0.5), (Linden, 0.5)],
            props: Props(
                street_light_m: 35, street_tree_m: 25, hydrant_m: 0, power_pole_m: 0,
                bench_per_km: 15, billboard_per_km: 0, neon: 0, parked_cars: (0.3, 0.6),
            ),
            lots: Lots(width_m: (30, 60), depth_m: 40, setback_m: (2, 2, 2)),
        ),
        farmland: ZoneRule(
            block_m: ((400, 805), (400, 805)),
            streets: Sections,
            alleys: false,
            styles: [Barn],
            trees: [(Oak, 1.0)],
            props: Props(
                street_light_m: 0, street_tree_m: 0, hydrant_m: 0, power_pole_m: 50,
                bench_per_km: 0, billboard_per_km: 0, neon: 0, parked_cars: (0.0, 0.05),
            ),
            lots: Lots(width_m: (120, 250), depth_m: 200, setback_m: (15, 10, 10)),
        ),
        hills: ZoneRule(
            block_m: ((200, 400), (150, 300)),
            streets: Grid,
            alleys: false,
            styles: [Bungalow],
            trees: [(Oak, 1.0)],
            props: Props(
                street_light_m: 60, street_tree_m: 0, hydrant_m: 200, power_pole_m: 50,
                bench_per_km: 0, billboard_per_km: 0, neon: 0, parked_cars: (0.0, 0.1),
            ),
            lots: Lots(width_m: (25, 45), depth_m: 40, setback_m: (8, 4, 8)),
        ),
        highway: ZoneRule(
            block_m: ((400, 800), (64, 64)),
            streets: Grid,
            alleys: false,
            styles: [],
            trees: [],
            props: Props(
                street_light_m: 45, street_tree_m: 0, hydrant_m: 0, power_pole_m: 0,
                bench_per_km: 0, billboard_per_km: 4, neon: 0, parked_cars: (0.0, 0.0),
            ),
            lots: Lots(width_m: (40, 80), depth_m: 40, setback_m: (0, 0, 0)),
        ),
    ),
)
