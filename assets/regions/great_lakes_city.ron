        wiggle_m: 15,
        bays: (0, 1),
        bay_depth_m: (40, 90),
        bay_width_m: (500, 800),
        canals: None,
    ),

    // Edges: the lake east; the grid gives way to rail yards and industry west and north, and the
    // expressway loops back along a ridge south.
    edges: Edges(north: RailYards, east: Lake, south: HighwayLoop, west: RailYards),

    elevation: Elevation(
        water_level_m: 176,
        shelf_depth_m: 8,
        beach_width_m: (30, 70),
