        wiggle_m: 20,
        bays: (0, 0),
        bay_depth_m: (0, 0),
        bay_width_m: (500, 800),
        canals: None,
    ),

    // Edges: the lake east, the forest preserve west, the expressway looping back north and south.
    edges: Edges(north: HighwayLoop, east: Lake, south: HighwayLoop, west: Forest),

