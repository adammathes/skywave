            ),
            lots: Lots(width_m: (60, 120), depth_m: 60, setback_m: (6, 4, 6)),
            massing: Some(Massing(coverage: 0.5, floors: (1, 2), floors_mean: 1.2, floors_spread: 0.3, style_weights: [4, 1])),
        ),
        commercial: ZoneRule(
            score: Some(Score(
                base: 0,
                coast: [],
                slope: [(0.06, 0), (0.14, -3)],
                downtown: [(0, 1.6), (300, 1.6), (430, 0.9), (580, -1.5)],
                highway: [(0, 0.3), (200, 0)],
                noise: 0.5,
                noise_scale_m: 180,
            )),
            block_m: ((90, 130), (60, 90)),
            streets: Grid,
            alleys: true,
            styles: [StripMall, StuccoBox, Deco, Brick],
            trees: [(Palm, 0.6), (FanPalm, 0.4)],
            props: Props(
                street_light_m: 35, street_tree_m: 20, hydrant_m: 90, power_pole_m: 0,
                bench_per_km: 4, billboard_per_km: 1, neon: 0.35, parked_cars: (0.3, 0.6),
            ),
            lots: Lots(width_m: (20, 40), depth_m: 40, setback_m: (3, 0, 4)),
            massing: Some(Massing(coverage: 0.6, floors: (1, 4), floors_mean: 2, floors_spread: 0.45, style_weights: [2, 2, 1, 1])),
        ),
        park: ZoneRule(
            score: None,
            block_m: ((120, 240), (100, 200)),
            streets: Curvy,
            alleys: false,
            styles: [],
            trees: [(Palm, 0.3), (Oak, 0.3), (Sycamore, 0.2), (Cypress, 0.2)],
            props: Props(
                street_light_m: 40, street_tree_m: 12, hydrant_m: 0, power_pole_m: 0,
                bench_per_km: 20, billboard_per_km: 0, neon: 0, parked_cars: (0.0, 0.2),
            ),
            lots: Lots(width_m: (40, 80), depth_m: 40, setback_m: (0, 0, 0)),
        ),
        beach: ZoneRule(
            score: None,
            block_m: ((150, 300), (60, 120)),
            streets: Beachfront,
            alleys: false,
            styles: [StuccoBox, Motel],
            trees: [(Palm, 0.7), (FanPalm, 0.3)],
            props: Props(
                street_light_m: 35, street_tree_m: 25, hydrant_m: 0, power_pole_m: 0,
