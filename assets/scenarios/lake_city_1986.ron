// Lake City, 1986 (docs/SCENARIOS.md): built to work, warm inside. The `great_lakes_city`
// region template and its grammar, brick and limestone, the 1980s roster with the family wagon to start in,
// the Chicago radio preset, late afternoon going to dusk. Format: crates/app/src/scenario.rs.
Scenario(
    id: "lake_city_1986",
    title: "Lake City",
    year: 1986,
    kind: "Lake city",
    // The elevated train rattling over the streets on its steel.
    sounds: ["el_train"],
    region: "great_lakes_city",
    layout: Some("lake_city"),
    grammar: "great_lakes_80s.ron",
    radio: "1977_chicago",
    palette: "brick_and_limestone",
    map_skin: "transit",
    default_time: (16, 50),
    default_vehicle: "homestead_wagon",
    years: (1977, 1989),
    // The cars of the North Side's summer nights, kept on the road past their age: the late
    // pony hatch with its T-tops and stripes, and the plastic-bodied V8 sports car.
    heroes: ["corvid_hatch", "longbow_coupe"],
)
