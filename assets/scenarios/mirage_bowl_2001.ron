// Mirage Bowl, 2001 (docs/SCENARIOS.md, docs/LAYOUTS.md, docs/backlog/MIRAGE2001.md): the
// authored `mirage_bowl` layout, a basin floor in a ring of mountains, dressed by the
// `socal_bowl` zone rules, the `socal_basin_2001` grammar, the `sodium_night` palette and the
// `2001_basin` radio preset. Its years filter the roster: the 2001 hero cars are its own and
// start it, the 1980s cars are old here and weigh less by their age.
Scenario(
    id: "mirage_bowl_2001",
    title: "Mirage Bowl",
    year: 2001,
    kind: "Basin in the mountains",
    region: "socal_bowl",
    layout: Some("mirage_bowl"),
    grammar: "socal_basin_2001.ron",
    radio: "2001_basin",
    palette: "sodium_night",
    map_skin: "atlas",
    default_time: (15, 30),
    default_vehicle: "halberd_coupe",
    years: (1995, 2001),
    // Clear air, the day after the wind: the mountain front stands over the whole floor.
    haze: 0.45,
    heroes: [
        "halberd_coupe", "halberd_targa", "tanager_awd", "destrier_coupe", "siskin_coupe",
        "shrike_coupe", "glaive_turbo", "falchion_sedan", "courser_v8",
        "dunlin_roadster", "palfrey_roadster",
    ],
)
