// Mirage Valley, 2001 (docs/SCENARIOS.md, docs/backlog/MIRAGE2001.md): the `socal_basin` region
// template. STUB: the grammar, the palette and the radio preset are the coast's until the
// `socal_basin_2001` grammar, the `sodium_night` palette and the `2001_basin` preset land
// (MIRAGE2001 items 3 and 8); the World page marks it "coming". Its years
// already filter the roster: the 2001 hero cars are its own and start it, the 1980s cars are
// old here and weigh less by their age.
Scenario(
    id: "mirage_valley_2001",
    title: "Mirage Valley",
    year: 2001,
    kind: "Inland grid",
    region: "socal_basin",
    grammar: "california_coast_80s.ron",
    radio: "1984_socal",
    palette: "socal_1985",
    default_time: (22, 30),
    default_vehicle: "halberd_coupe",
    years: (1995, 2001),
    heroes: [
        "halberd_coupe", "halberd_targa", "tanager_awd", "destrier_coupe", "siskin_coupe",
        "shrike_coupe", "glaive_turbo", "falchion_sedan", "courser_v8",
    ],
    stub: true,
)
