// The Bay Loop, 2005 (docs/SCENARIOS.md, "The Bay Loop"): a compressed Bay Area as one ring of
// districts around the water, from the authored `bay_loop` layout (docs/LAYOUTS.md) dressed by
// the `bay_area` zone rules. The radio and the palette are borrowed until the world has its own.
Scenario(
    id: "bay_loop_2005",
    title: "Bay Loop",
    year: 2005,
    kind: "Bay and hills",
    region: "bay_area",
    layout: Some("bay_loop"),
    grammar: "socal_basin_2001.ron",
    radio: "2001_basin",
    palette: "socal_1985",
    map_skin: "nav",
    default_time: (16, 10),
    default_vehicle: "goshawk_turbo",
    years: (2000, 2005),
    // The Bay's own: a turbo commuter and a luxury six off the Peninsula's lots, and two VC toys.
    heroes: ["goshawk_turbo", "tulwar_sedan", "petrel_roadster", "lipizzan_sedan"],
)
