// The Bay Loop, 2005 (docs/SCENARIOS.md, "The Bay Loop"): a compressed Bay Area as one ring of
// districts around the water, from the authored `bay_loop` layout (docs/LAYOUTS.md) dressed by
// the `bay_area` zone rules. The radio is borrowed until the world has its own.
Scenario(
    id: "bay_loop_2005",
    title: "Bay Loop",
    year: 2005,
    kind: "Bay and hills",
    region: "bay_area",
    layout: Some("bay_loop"),
    grammar: "bay_area_2005.ron",
    radio: "2001_basin",
    palette: "bay_2005",
    default_time: (16, 10),
    default_vehicle: "goshawk_turbo",
    years: (1996, 2005),
    // The Bay's own: a turbo commuter and a luxury six off the Peninsula's lots, and two VC toys.
    heroes: ["goshawk_turbo", "tulwar_sedan", "petrel_roadster", "lipizzan_sedan"],
    // The marine layer: out past the ocean beach by day, it pours in over the city and the
    // ridge's low end from half past three, fills the Peninsula to the bay shore by half past
    // six, and burns off by half past eleven. The ridge and the East Bay hills stand above it.
    fog_bank: Some(FogBank(sea_x: -600, inland_x: 2000, top_m: 60, density: 0.012)),
)
