Scenario(
    id: "bay_loop_2005",
    title: "Bay Loop",
    year: 2005,
    kind: "Bay and hills",
    region: "bay_area",
    layout: Some("bay_loop"),
    grammar: "bay_area_2005.ron",
    radio: "2001_basin",
    palette: "bay_2005",
    map_skin: "nav",
    default_time: (16, 10),
    default_vehicle: "halberd_coupe",
    years: (1996, 2005),
    heroes: [],
)
