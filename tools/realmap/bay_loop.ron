        "Sloat Blvd", "Sneath Ln", "Stanyan St", "Stevens Creek Blvd", "Stevenson Blvd", "Story Rd",
        "Sunset Blvd", "Tasman Dr", "Telegraph Ave", "Tennyson Rd", "The Alameda",
        "The Embarcadero", "Thornton Ave", "Trimble Rd", "Tully Rd", "Union Ave", "University Ave",
        "Van Ness Ave", "W 3rd Ave", "W A St", "W Campbell Ave", "W Capitol Ave", "W Charleston Rd",
        "W El Camino Real", "W Fremont Ave", "W Grand Ave", "W Hamilton Ave", "W Hillsdale Blvd",
        "W Homestead Rd", "W Jackson St", "W Market St", "W Middlefield Rd", "W Mission St",
        "W Montague Expy", "W Santa Clara St", "W Sunset Blvd", "W Tasman Dr", "W Tennyson Rd",
        "W Trimble Rd", "Warm Springs Blvd", "Westborough Blvd", "Whipple Ave", "Whipple Rd",
