// The Bay Loop from real data (`cargo run -p realmap -- tools/realmap/bay_loop.ron`): the
// Bay Area from the Golden Gate to the South Bay foothills, squeezed into a 4 km frame. The
// city gets about twice the room of the land around it (about 1:9 against 1:20), so its
// crests and grid read at driving scale. Districts are drawn here in degrees so they move
// with the warp.
Import(
    layout: "assets/layouts/bay_loop.ron",
    state: "06",
    // The counties' all-roads files, so the main streets that are not state routes come in
    // by name (their real names stay here; the game's are invented).
    counties: ["06075", "06081", "06085", "06001"],
    names: [
        "14th St", "16th St", "19th Ave", "1st St", "3rd Ave", "3rd St", "98th Ave", "A St",
        "Airport Blvd", "Alameda de Las Pulgas", "Alemany Blvd", "Alma St", "Almaden Expy",
        "Alum Rock Ave", "Alvarado Blvd", "Arastradero Rd", "Ashby Ave", "Bascom Ave", "Bay Rd",
        "Bayfront Expy", "Bayshore Blvd", "Blossom Hill Rd", "Bowers Ave", "Branham Ln", "Broadway",
        "Brokaw Rd", "California St", "Camden Ave", "Campbell Ave", "Capitol Ave", "Capitol Expy",
        "Central Expy", "Cesar Chavez St", "Charleston Rd", "Coleman Ave", "College Ave",
        "Davis St", "De Anza Blvd", "Decoto Rd", "Divisadero St", "Dwight Way", "E 14th St",
        "E 16th St", "E 3rd Ave", "E 3rd St", "E Brokaw Rd", "E Campbell Ave", "E Capitol Ave",
        "E Charleston Rd", "E El Camino Real", "E Fremont Ave", "E Grand Ave", "E Hamilton Ave",
        "E Hillsdale Blvd", "E Homestead Rd", "E Junipero Serra Blvd", "E Market St",
        "E Middlefield Rd", "E Millbrae Ave", "E Mission St", "E Santa Clara St", "E Tasman Dr",
        "E Trimble Rd", "Edgewood Rd", "El Camino Real", "Embarcadero Rd", "Fell St", "Fillmore St",
        "Folsom St", "Foothill Blvd", "Foothill Expy", "Franklin St", "Fremont Ave", "Fremont Blvd",
        "Fruitvale Ave", "Fulton St", "Geary Blvd", "Geneva Ave", "Gough St", "Grand Ave",
        "Grant Rd", "Great America Pkwy", "Great Hwy", "Hamilton Ave", "Hegenberger Rd",
        "Hesperian Blvd", "Hickey Blvd", "High St", "Holly St", "Homestead Rd",
        "International Blvd", "Jackson St", "Jefferson Ave", "Junipero Serra Blvd", "King Rd",
        "Lafayette St", "Lawrence Expy", "Lincoln Way", "Lombard St", "Los Gatos Blvd",
        "Marina Blvd", "Market St", "Marsh Rd", "Masonic Ave", "Mathilda Ave", "McKee Rd",
        "Meridian Ave", "Middlefield Rd", "Millbrae Ave", "Mission Blvd", "Mission St",
        "Montague Expy", "Monterey Blvd", "N 14th St", "N 16th St", "N 1st St", "N 3rd St",
        "N Bascom Ave", "N Bayshore Blvd", "N Capitol Ave", "N De Anza Blvd", "N El Camino Real",
        "N Foothill Blvd", "N King Rd", "N Market St", "N Mathilda Ave", "N Rengstorff Ave",
        "N San Antonio Rd", "N Saratoga Sunnyvale Rd", "N Shoreline Blvd", "N Winchester Blvd",
        "N Wolfe Rd", "Oak St", "Ocean Ave", "Oregon Expy", "Page Mill Rd", "Park Presidio Blvd",
        "Paseo Padre Pkwy", "Peninsula Ave", "Portola Dr", "Potrero Ave", "Prospect Rd",
        "Ralston Ave", "S 14th St", "S 16th St", "S 1st St", "S 3rd St", "S Airport Blvd",
        "S Bascom Ave", "S Bayshore Blvd", "S Broadway", "S De Anza Blvd", "S El Camino Real",
        "S Foothill Blvd", "S King Rd", "S Market St", "S Mathilda Ave", "S Rengstorff Ave",
        "S San Antonio Rd", "S Saratoga Sunnyvale Rd", "S Shoreline Blvd", "S Van Ness Ave",
